<div class="pf-app" id="projectflow-mytasks" data-task-endpoint="{{ ajax_task_url }}" data-csrf="{{ csrf_token }}">
  <section class="pf-hero pf-hero-dashboard pf-hero-mytasks"><div><div class="pf-eyebrow">EXECUÇÃO PESSOAL</div><h1>Minhas tarefas de projeto</h1><p>Sua fila de execução sem precisar abrir a gestão completa de cada projeto.</p></div><a class="btn btn-outline-secondary" href="{{ dashboard_url }}"><i class="ti ti-layout-dashboard"></i> Projetos</a></section>
  <div class="pf-stat-grid pf-stat-grid-six"><div class="pf-stat-card"><i class="ti ti-checklist"></i><span>Total ativo</span><strong>{{ stats.total }}</strong></div><div class="pf-stat-card {{ stats.overdue ? 'is-danger' : '' }}"><i class="ti ti-alert-circle"></i><span>Em atraso</span><strong>{{ stats.overdue }}</strong></div><div class="pf-stat-card"><i class="ti ti-calendar-event"></i><span>Hoje</span><strong>{{ stats.today }}</strong></div><div class="pf-stat-card"><i class="ti ti-calendar-week"></i><span>Próx. 7 dias</span><strong>{{ stats.next7 }}</strong></div><div class="pf-stat-card {{ stats.attention ? 'is-warning' : '' }}"><i class="ti ti-alert-triangle"></i><span>Atenção</span><strong>{{ stats.attention }}</strong></div><div class="pf-stat-card {{ stats.reminders ? 'is-warning' : '' }}"><i class="ti ti-bell-ringing"></i><span>Lembretes</span><strong>{{ stats.reminders }}</strong></div></div>
  <section class="pf-panel mt-3"><div class="pf-panel-header"><div><div class="pf-eyebrow">FILA</div><h2>O que você precisa executar</h2></div><div class="pf-search pf-search-sm"><i class="ti ti-search"></i><input class="form-control" id="pf-my-task-search" placeholder="Buscar tarefa ou projeto..."></div></div>
    <div class="pf-my-task-list">{% for task in tasks %}<a class="pf-my-task-row {{ task.attention ? 'has-attention' : '' }} {{ task.reminder_due ? 'has-reminder' : '' }}" href="{{ task.task_url }}" data-search="{{ (task.name ~ ' ' ~ task.project_name ~ ' ' ~ task.state.name)|lower }}"><div class="pf-my-task-state"><span class="pf-column-dot" style="--pf-state-color:{{ task.state.color }}"></span></div><div class="pf-my-task-content"><div><strong>{{ task.name }}</strong>{% if task.attention %}<span class="pf-mini-attention"><i class="ti ti-alert-triangle"></i> Atenção</span>{% endif %}{% if task.reminder_due %}<span class="pf-mini-reminder"><i class="ti ti-bell-ringing"></i> Lembrete</span>{% endif %}</div><span>{{ task.project_name }}{% if task.project_code %} · {{ task.project_code }}{% endif %}</span></div><div class="pf-my-task-status"><strong>{{ task.state.name }}</strong><span>{{ task.percent_done }}%</span></div><div class="pf-my-task-priority"><i class="ti ti-flag"></i>{{ task.priority_name }}</div><time class="{{ task.is_overdue ? 'pf-text-danger' : '' }}">{{ task.plan_end_date ? task.plan_end_date|date('d/m/Y') : 'Sem prazo' }}</time><i class="ti ti-chevron-right"></i></a>{% else %}<div class="pf-empty-state"><i class="ti ti-circle-check"></i><strong>Nenhuma tarefa ativa para você</strong><p>Quando você for adicionado à equipe de uma tarefa, ela aparecerá aqui.</p></div>{% endfor %}</div>
  </section>
</div>
