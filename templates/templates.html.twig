<div class="pf-app" id="projectflow-templates" data-project-endpoint="{{ ajax_project_url }}" data-csrf="{{ csrf_token }}">
  <section class="pf-hero"><div><div class="pf-eyebrow">PADRONIZAÇÃO</div><h1>Templates de projeto</h1><p>Reutilize templates nativos do GLPI preservando tarefas, equipe e relacionamentos clonáveis.</p></div><div class="pf-hero-actions"><a class="btn btn-outline-secondary" href="{{ dashboard_url }}"><i class="ti ti-arrow-left"></i> Portfólio</a></div></section>
  {% if templates is empty %}<div class="pf-empty"><i class="ti ti-template-off"></i><h3>Nenhum template nativo encontrado</h3><p>Crie um projeto como template no GLPI e ele aparecerá aqui automaticamente.</p></div>{% else %}<div class="pf-template-grid">{% for template in templates %}<article class="pf-template-card"><div class="pf-template-icon"><i class="ti ti-template"></i></div><div><h3>{{ template.name }}</h3><p>{{ template.description ?: 'Template de projeto nativo do GLPI.' }}</p></div><div class="pf-template-actions"><a href="{{ template.native_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-external-link"></i> Ver nativo</a>{% if can_create_project %}<button class="btn btn-sm btn-primary pf-use-template" data-template-id="{{ template.id }}" data-template-name="{{ template.name }}"><i class="ti ti-copy"></i> Usar template</button>{% endif %}</div></article>{% endfor %}</div>{% endif %}
  {% if can_create_project %}<div class="modal fade" id="pf-template-create-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content pf-modal-content"><form id="pf-template-create-form"><div class="modal-header"><div><div class="pf-eyebrow">CRIAR A PARTIR DO TEMPLATE</div><h2 class="modal-title fs-4" id="pf-template-modal-title">Novo projeto</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="create"><input type="hidden" name="template_id"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}"><div class="row g-3"><div class="col-md-8"><label class="form-label">Nome *</label><input name="name" class="form-control" required></div><div class="col-md-4"><label class="form-label">Código</label><input name="code" class="form-control"></div><div class="col-md-4"><label class="form-label">Entidade</label><select name="entities_id" class="form-select">{% for entity in entities %}<option value="{{ entity.id }}">{{ entity.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Estado</label><select name="projectstates_id" class="form-select">{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_project_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == 3 ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ default_execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ default_execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select></div><div class="col-md-6"><label class="form-label">Contabilização</label><select name="cost_mode" class="form-select"><option value="hours" {{ default_cost_mode == 'hours' ? 'selected' : '' }}>Horas</option><option value="money" {{ default_cost_mode == 'money' ? 'selected' : '' }}>Custo financeiro</option></select></div><div class="col-md-6"><label class="form-label">Horas previstas / contratadas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" placeholder="Ex.: 160"></div><div class="col-md-6"><label class="form-label">Responsável</label><select name="users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Grupo</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" class="form-control"></div><div class="col-md-6"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" class="form-control"></div><div class="col-md-6"><label class="form-label">Portfólio</label><input name="portfolio" class="form-control"></div><div class="col-md-6"><label class="form-label">Patrocinador</label><input name="sponsor" class="form-control"></div></div><div class="pf-form-message mt-3" id="pf-template-create-message"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit"><i class="ti ti-copy"></i> Criar projeto</button></div></form></div></div></div>{% endif %}
</div>
