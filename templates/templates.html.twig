<div class="pf-app" id="projectflow-templates" data-project-endpoint="{{ ajax_project_url }}" data-csrf="{{ csrf_token }}">
  <nav class="pf-dash-menu pf-dash-menu-split" aria-label="Ações de templates">
    <a class="pf-dash-menu-link" href="{{ dashboard_url }}"><i class="ti ti-arrow-left"></i> Portfólio</a>
    <span class="pf-dash-menu-title"><i class="ti ti-template"></i> Templates de projeto</span>
    {% if can_create_project %}
      <button class="btn btn-primary btn-sm pf-dash-menu-new" type="button" data-bs-toggle="modal" data-bs-target="#pf-template-new-modal"><i class="ti ti-plus"></i> Novo template</button>
    {% endif %}
  </nav>

  {% set tpl_tasks = 0 %}{% for t in templates %}{% set tpl_tasks = tpl_tasks + t.tasks_count %}{% endfor %}
  <section class="pf-tpl-hero">
    <div class="pf-tpl-hero-text">
      <div class="pf-eyebrow">PADRONIZAÇÃO</div>
      <h1>Modelos prontos para começar projetos</h1>
      <p>Um template guarda tarefas, equipe, contabilização e configurações que se repetem. Ao criar um projeto a partir dele, tudo vem preenchido e você escolhe quais tarefas entram.</p>
    </div>
    <div class="pf-tpl-hero-stats">
      <div><strong>{{ templates|length }}</strong><span>template(s)</span></div>
      <div><strong>{{ tpl_tasks }}</strong><span>tarefa(s) padrão</span></div>
    </div>
  </section>

  {% if templates is empty %}
    <div class="pf-tpl-empty">
      <span class="pf-tpl-empty-icon"><i class="ti ti-template"></i></span>
      <h3>Nenhum template ainda</h3>
      <p>Crie o primeiro modelo com as tarefas e as configurações que sempre se repetem nos seus projetos.</p>
      {% if can_create_project %}<button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#pf-template-new-modal"><i class="ti ti-plus"></i> Criar primeiro template</button>{% endif %}
    </div>
  {% else %}
    <div class="pf-tpl-toolbar">
      <div class="pf-search"><i class="ti ti-search"></i><input id="pf-tpl-search" class="form-control" type="search" placeholder="Buscar template por nome, código, tipo ou descrição..."></div>
      <span class="pf-tpl-count"><span id="pf-tpl-visible">{{ templates|length }}</span> de {{ templates|length }}</span>
    </div>
    <div class="pf-tpl-grid" id="pf-tpl-grid">
      {% for template in templates %}
        <article class="pf-tpl-card pf-tpl-cost-{{ template.cost_mode }}" data-search="{{ (template.name ~ ' ' ~ template.code ~ ' ' ~ template.type_name ~ ' ' ~ template.description)|lower }}">
          <header class="pf-tpl-card-head">
            <span class="pf-tpl-card-icon"><i class="ti ti-template"></i></span>
            <div class="pf-tpl-card-title">
              <h3 title="{{ template.name }}">{{ template.name }}</h3>
              <div class="pf-tpl-card-sub">{% if template.code %}<span class="pf-tpl-code">{{ template.code }}</span>{% endif %}{% if template.type_name %}<span>{{ template.type_name }}</span>{% endif %}{% if not template.code and not template.type_name %}<span>Sem código ou tipo</span>{% endif %}</div>
            </div>
            <div class="dropdown">
              <button class="btn btn-sm btn-ghost-secondary pf-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mais opções"><i class="ti ti-dots-vertical"></i></button>
              <div class="dropdown-menu dropdown-menu-end">
                {% if template.can_update %}<a class="dropdown-item" href="{{ template.plugin_url }}"><i class="ti ti-pencil"></i> Editar template</a>{% endif %}
                <a class="dropdown-item" href="{{ template.native_url }}"><i class="ti ti-external-link"></i> Abrir no GLPI</a>
              </div>
            </div>
          </header>
          <p class="pf-tpl-desc {{ template.description ? '' : 'is-empty' }}">{{ template.description ?: 'Sem descrição. Edite o template para explicar quando usá-lo.' }}</p>
          <ul class="pf-tpl-facts">
            <li><i class="ti ti-list-check"></i><span><strong>{{ template.tasks_count }}</strong> tarefa(s){% if template.task_hours_label %} · {{ template.task_hours_label }} planejadas{% endif %}</span></li>
            <li><i class="ti ti-{{ template.cost_mode == 'money' ? 'currency-real' : (template.cost_mode == 'both' ? 'coin' : 'clock-hour-4') }}"></i><span>{{ template.cost_label }}{% if template.budget_label %} · {{ template.budget_label }} previstas{% endif %}</span></li>
            <li><i class="ti ti-route"></i><span>{{ template.execution_label }}</span></li>
            {% if template.manager_name %}<li><i class="ti ti-user"></i><span>{{ template.manager_name }}</span></li>{% endif %}
          </ul>
          <footer class="pf-tpl-card-foot">
            {% if can_create_project %}<a class="btn btn-primary pf-tpl-use" href="{{ template.use_url }}"><i class="ti ti-rocket"></i> Criar projeto</a>{% endif %}
            {% if template.can_update %}<a class="btn btn-outline-secondary" href="{{ template.plugin_url }}" title="Editar tarefas, equipe e configurações"><i class="ti ti-pencil"></i> Editar</a>{% endif %}
          </footer>
        </article>
      {% endfor %}
      {% if can_create_project %}
        <button type="button" class="pf-tpl-card pf-tpl-card-new" data-bs-toggle="modal" data-bs-target="#pf-template-new-modal"><span class="pf-tpl-empty-icon"><i class="ti ti-plus"></i></span><strong>Novo template</strong><span>Padronize outro tipo de projeto</span></button>
      {% endif %}
    </div>
    <div class="pf-tpl-noresult d-none" id="pf-tpl-noresult"><i class="ti ti-search-off"></i> Nenhum template encontrado para a busca.</div>
  {% endif %}

  {% if can_create_project %}
  <div class="modal fade" id="pf-template-new-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content pf-modal-content">
    <form id="pf-template-new-form">
      <div class="modal-header"><div><div class="pf-eyebrow">NOVO TEMPLATE</div><h2 class="modal-title fs-4">Criar template de projeto</h2><p class="mb-0 text-muted">Tudo o que for definido aqui é copiado para cada projeto criado a partir do template.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><input type="hidden" name="action" value="template_create"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <nav class="pf-form-tabs" role="tablist"><button type="button" data-pf-form-tab="ident" class="is-active"><span class="pf-form-tab-step">1</span><i class="ti ti-id"></i><span>Identificação</span></button><button type="button" data-pf-form-tab="plan"><span class="pf-form-tab-step">2</span><i class="ti ti-calendar-stats"></i><span>Planejamento</span></button><button type="button" data-pf-form-tab="gov"><span class="pf-form-tab-step">3</span><i class="ti ti-shield-check"></i><span>Governança</span></button><button type="button" data-pf-form-tab="cost"><span class="pf-form-tab-step">4</span><i class="ti ti-coin"></i><span>Contabilização</span></button><button type="button" data-pf-form-tab="tasks"><span class="pf-form-tab-step">5</span><i class="ti ti-list-check"></i><span>Tarefas</span></button></nav>
        <div class="pf-form-section" data-pf-form-pane="ident"><p class="pf-pane-lead">Nome, origem e descrição do template.</p><div class="row g-3">
          <div class="col-lg-8"><label class="form-label">Nome do template *</label><input name="name" class="form-control" maxlength="255" required placeholder="Ex.: Implantação GLPI padrão"></div>
          <div class="col-lg-4"><label class="form-label">Código</label><input name="code" class="form-control" maxlength="255" placeholder="Ex.: IMPL"></div>
          <div class="col-lg-4"><label class="form-label">Basear em</label><select name="source_project_id" class="form-select"><option value="0">Template em branco</option>{% if source_projects %}<optgroup label="Copiar projeto existente">{% for p in source_projects %}<option value="{{ p.id }}">{{ p.name }}{% if p.code %} · {{ p.code }}{% endif %}</option>{% endfor %}</optgroup>{% endif %}{% if templates %}<optgroup label="Duplicar template">{% for t in templates %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}</optgroup>{% endif %}</select><small class="text-muted">Copia tarefas, equipe e relações. Horas lançadas e reuniões não vão junto.</small></div>
          <div class="col-lg-4"><label class="form-label">Entidade</label><select name="entities_id" class="form-select">{% for entity in entities %}<option value="{{ entity.id }}">{{ entity.name }}</option>{% endfor %}</select></div>
          <div class="col-lg-4"><label class="form-label">Tipo</label><select name="projecttypes_id" class="form-select"><option value="0">Não definido</option>{% for type in project_types %}<option value="{{ type.id }}">{{ type.name }}</option>{% endfor %}</select></div>
          <div class="col-12"><label class="form-label">Objetivo / descrição executiva</label><textarea name="objective" class="form-control" rows="2" maxlength="4000" placeholder="Que tipo de entrega este template padroniza?"></textarea></div>
          <div class="col-12"><label class="form-label">Descrição operacional</label><textarea name="content" class="form-control" rows="3" maxlength="10000" placeholder="Quando usar este template e o que ele cobre"></textarea></div>
        </div></div>
        <div class="pf-form-section d-none" data-pf-form-pane="plan"><p class="pf-pane-lead">Estado inicial, execução e responsáveis padrão.</p><div class="row g-3">
          <div class="col-md-3"><label class="form-label">Estado inicial</label><select name="projectstates_id" class="form-select">{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_project_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for priority in priorities %}<option value="{{ priority.id }}" {{ priority.id == 3 ? 'selected' : '' }}>{{ priority.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ default_execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ default_execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select><small class="text-muted">No template, chamados não são abertos.</small></div>
          <div class="col-md-3"><label class="form-label">Responsável</label><select name="users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Grupo responsável</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></div>
        </div></div>
        <div class="pf-form-section d-none" data-pf-form-pane="gov"><p class="pf-pane-lead">Portfólio, patrocinador, saúde, risco e visibilidade.</p><div class="row g-3">
          <div class="col-md-3"><label class="form-label">Portfólio</label><input name="portfolio" class="form-control" maxlength="190" placeholder="Ex.: Segurança"></div>
          <div class="col-md-3"><label class="form-label">Patrocinador</label><input name="sponsor" class="form-control" maxlength="190"></div>
          <div class="col-md-3"><label class="form-label">Risco</label><select name="risk_level" class="form-select"><option value="low">Baixo</option><option value="normal" selected>Normal</option><option value="high">Alto</option><option value="critical">Crítico</option></select></div>
          <div class="col-md-3"><label class="form-label">Saúde</label><select name="health" class="form-select"><option value="auto">Automática</option><option value="good">Saudável</option><option value="attention">Atenção</option><option value="critical">Crítico</option></select></div>
          <div class="col-md-3 d-flex align-items-end"><label class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="auto_percent_done" value="1" checked><span class="form-check-label">Progresso automático</span></label></div>
          <div class="col-md-3 d-flex align-items-end"><label class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="is_recursive" value="1"><span class="form-check-label">Visível em subentidades</span></label></div>
        </div></div>
        <div class="pf-form-section pf-accounting-section d-none" data-pf-form-pane="cost"><p class="pf-pane-lead">Como o esforço e o custo dos projetos criados serão acompanhados.</p>
          <div class="pf-accounting-options">
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="hours" {{ default_cost_mode == 'hours' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-clock-hour-4"></i></span><span><strong>Contabilizar horas</strong><small>Execução e reuniões, com previsto, consumido e saldo.</small></span></label>
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="money" {{ default_cost_mode == 'money' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-currency-real"></i></span><span><strong>Custo financeiro</strong><small>Lançamentos monetários para usuários com acesso gerencial.</small></span></label>
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="both" {{ default_cost_mode == 'both' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-coin"></i></span><span><strong>Horas + custo</strong><small>Horas previstas com valor por hora: cada hora lançada vira custo, e a gestão lança valores avulsos.</small></span></label>
          </div>
          <div class="row g-3 mt-1 pf-hours-budget-wrap"><div class="col-md-4"><label class="form-label">Horas previstas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" placeholder="Ex.: 160"></div><div class="col-md-4 pf-hour-rate-wrap"><label class="form-label">Valor por hora (R$)</label><input name="hour_rate" class="form-control pf-money-input" inputmode="decimal" placeholder="Ex.: 150,00"></div></div>
        </div>
        <div class="pf-form-section d-none" data-pf-form-pane="tasks"><div class="d-flex align-items-center justify-content-between gap-2 mb-2"><h3 class="mb-0">Tarefas do template</h3><button type="button" class="btn btn-sm btn-outline-primary" id="pf-template-task-add"><i class="ti ti-plus"></i> Adicionar tarefa</button></div>
          <p class="text-muted small mb-2">Cada projeto criado a partir deste template recebe estas tarefas. Dá para completar depois no workspace do template.</p>
          <div class="pf-template-task-head d-none d-lg-grid"><span>Tarefa *</span><span>Tipo</span><span>Horas previstas</span><span>Executor</span><span>Marco</span><span></span></div>
          <div id="pf-template-task-rows"></div>
          <div class="pf-template-task-empty text-muted small" id="pf-template-task-empty">Nenhuma tarefa adicionada.</div>
          <template id="pf-template-task-row">
            <div class="pf-template-task-row">
              <input class="form-control form-control-sm" data-field="name" maxlength="255" placeholder="Ex.: Levantamento de requisitos">
              <select class="form-select form-select-sm" data-field="projecttasktypes_id"><option value="0">Sem tipo</option>{% for type in task_types %}<option value="{{ type.id }}">{{ type.name }}</option>{% endfor %}</select>
              <input class="form-control form-control-sm" data-field="planned_duration_hours" type="number" min="0" step="0.25" placeholder="0">
              <select class="form-select form-select-sm" data-field="assignee_user_id"><option value="0">Definir no projeto</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select>
              <label class="form-check form-switch m-0" title="Marco do projeto"><input class="form-check-input" type="checkbox" data-field="is_milestone" value="1"></label>
              <button type="button" class="btn btn-sm btn-ghost-danger pf-icon-btn pf-template-task-remove" title="Remover tarefa"><i class="ti ti-trash"></i></button>
              <div class="pf-task-states-picker pf-template-task-states"><span class="pf-template-task-states-label">Estados permitidos</span><input type="hidden" class="pf-task-states-value" data-field="allowed_states" value="{{ []|join(',') }}"><div class="pf-state-chips">{% for state in states %}<label class="pf-state-chip"><input type="checkbox" class="form-check-input pf-task-state-check" value="{{ state.id }}" {{ not [] or state.id in [] ? 'checked' : '' }}><span class="pf-column-dot" style="--pf-state-color:{{ state.color }}"></span><span>{{ state.name }}</span></label>{% endfor %}</div></div>
              <textarea class="form-control form-control-sm pf-template-task-desc" data-field="content" rows="1" maxlength="10000" placeholder="Descrição (opcional)"></textarea>
            </div>
          </template>
        </div>
        <div class="pf-form-message"></div>
      </div>
      <div class="modal-footer pf-form-tabs-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><span class="pf-footer-spacer"></span><button type="button" class="btn btn-outline-secondary pf-form-prev d-none"><i class="ti ti-arrow-left"></i> Voltar</button><button type="button" class="btn btn-outline-primary pf-form-next">Próximo <i class="ti ti-arrow-right"></i></button><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Criar template</button></div>
    </form>
  </div></div></div>

  <div class="modal fade" id="pf-template-create-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content pf-modal-content"><form id="pf-template-create-form"><div class="modal-header"><div><div class="pf-eyebrow">CRIAR A PARTIR DO TEMPLATE</div><h2 class="modal-title fs-4" id="pf-template-modal-title">Novo projeto</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="action" value="create"><input type="hidden" name="template_id"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}"><div class="row g-3"><div class="col-md-8"><label class="form-label">Nome *</label><input name="name" class="form-control" required></div><div class="col-md-4"><label class="form-label">Código</label><input name="code" class="form-control"></div><div class="col-md-4"><label class="form-label">Entidade</label><select name="entities_id" class="form-select">{% for entity in entities %}<option value="{{ entity.id }}">{{ entity.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Estado</label><select name="projectstates_id" class="form-select">{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_project_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == 3 ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ default_execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ default_execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select></div><div class="col-md-6"><label class="form-label">Contabilização</label><select name="cost_mode" class="form-select"><option value="hours" {{ default_cost_mode == 'hours' ? 'selected' : '' }}>Horas</option><option value="money" {{ default_cost_mode == 'money' ? 'selected' : '' }}>Custo financeiro</option><option value="both" {{ default_cost_mode == 'both' ? 'selected' : '' }}>Horas + custo</option></select><small class="text-muted">Deixe como está para usar o do template.</small></div><div class="col-md-6"><label class="form-label">Valor por hora (R$)</label><input name="hour_rate" class="form-control pf-money-input" inputmode="decimal" placeholder="Vazio = valor do template"></div><div class="col-md-6"><label class="form-label">Horas previstas / contratadas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" placeholder="Ex.: 160"></div><div class="col-md-6"><label class="form-label">Responsável</label><select name="users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Grupo</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" class="form-control"></div><div class="col-md-6"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" class="form-control"></div><div class="col-md-6"><label class="form-label">Portfólio</label><input name="portfolio" class="form-control"></div><div class="col-md-6"><label class="form-label">Patrocinador</label><input name="sponsor" class="form-control"></div></div><div class="pf-form-message mt-3" id="pf-template-create-message"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit"><i class="ti ti-copy"></i> Criar projeto</button></div></form></div></div></div>
  {% endif %}
</div>
