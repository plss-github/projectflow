<div class="pf-app {{ compact_cards ? 'pf-compact' : '' }}" id="projectflow-workspace"
 data-project-id="{{ project.id }}" data-task-endpoint="{{ ajax_task_url }}" data-project-endpoint="{{ ajax_project_url }}"
 data-document-endpoint="{{ ajax_document_url }}" data-csrf="{{ csrf_token }}">

  <section class="pf-project-hero pf-project-hero-v3">
    <div class="pf-breadcrumb-row">
      {% if project.is_template %}<a href="{{ templates_url }}"><i class="ti ti-arrow-left"></i> Templates</a><span>/</span>{% else %}<a href="{{ dashboard_url }}"><i class="ti ti-arrow-left"></i> Projetos</a><span>/</span>{% endif %}
      <span>{{ project.code ?: 'PROJ-' ~ project.id }}</span>{% if project.portfolio %}<span>/</span><span>{{ project.portfolio }}</span>{% endif %}
    </div>
    <div class="pf-project-title-row">
      <div class="pf-project-heading">
        <div class="pf-title-with-state">
          <h1>{{ project.is_template and project.template_name ? project.template_name : project.name }}</h1>
          {% if project.is_template %}<span class="pf-template-badge" title="As tarefas, equipe e configurações deste template são copiadas para cada projeto criado a partir dele."><i class="ti ti-template"></i> Template</span>{% endif %}
          <span class="pf-state-badge" style="--pf-state-color:{{ project.state.color }}"><i></i>{{ project.state.name }}</span>
          <span class="pf-priority-badge pf-priority-{{ project.priority }}"><i class="ti ti-flag"></i>{{ project.priority_name }}</span>
          {% if task_stats.attention %}<span class="pf-attention-badge"><i class="ti ti-alert-triangle"></i>{{ task_stats.attention }} atenção</span>{% endif %}
        </div>
        <p>{{ project.objective ?: (project.content ?: 'Projeto sem objetivo executivo cadastrado.') }}</p>
      </div>
      <div class="pf-hero-actions pf-hero-actions-compact">
        <button type="button" class="btn btn-outline-secondary pf-project-shortcut" data-pf-goto="hours" title="{{ project.cost_mode == 'money' ? 'Abrir controle financeiro' : 'Abrir controle de horas' }}"><i class="ti ti-{{ project.cost_mode == 'money' and project.can_view_money ? 'wallet' : 'clock-hour-4' }}"></i> {{ project.cost_mode == 'money' and project.can_view_money ? 'Financeiro' : 'Horas' }}</button>
        {% if project.can_update %}<button type="button" class="btn btn-outline-secondary pf-project-shortcut" data-bs-toggle="modal" data-bs-target="#pf-contract-modal" title="Contrato vinculado ao projeto"><i class="ti ti-file-certificate"></i> Contrato</button>{% else %}<button type="button" class="btn btn-outline-secondary pf-project-shortcut" data-pf-goto="files" title="Ver contrato vinculado"><i class="ti ti-file-certificate"></i> Contrato</button>{% endif %}
        {% if project.can_update %}<button type="button" class="btn btn-outline-secondary pf-icon-btn" data-bs-toggle="modal" data-bs-target="#pf-project-edit-modal" title="Configurações do projeto"><i class="ti ti-settings"></i></button>{% endif %}
        <button type="button" class="btn btn-outline-secondary pf-icon-btn pf-favorite {{ project.is_favorite ? 'is-active' : '' }}" data-project-id="{{ project.id }}" title="Favoritar projeto"><i class="ti ti-star{{ project.is_favorite ? '-filled' : '' }}"></i></button>
      </div>
    </div>

    <div class="pf-project-pulse">
      <div><span>Responsável</span><strong>{{ project.manager_name }}</strong></div>
      <div><span>Prazo</span><strong class="{{ project.is_overdue ? 'pf-text-danger' : '' }}">{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : 'Não definido' }}</strong></div>
      <div><span>Progresso</span><strong>{{ project.percent_done }}%</strong><div class="progress pf-progress"><div class="progress-bar" style="width:{{ project.percent_done }}%"></div></div></div>
      {% if project.cost_mode == 'money' and project.can_view_money %}<div><span>Custo financeiro</span><strong>R$ {{ project.costs.total_formatted }}</strong><small>Controle financeiro do projeto</small></div>{% else %}<div><span>Horas</span><strong>{{ project.hours.total_label }}{% if project.hours_budget.minutes %} / {{ project.hours_budget.label }}{% endif %}</strong><small>{{ project.hours.execution_label }} execução · {{ project.hours.meeting_label }} reunião{% if project.hours_budget.minutes %} · {{ project.hours_budget.remaining_label }} saldo{% endif %}</small></div>{% endif %}
      <div><span>Modo</span><strong>{{ project.execution_mode == 'ticket' ? 'Tarefa + chamado' : 'Tarefa direta' }}</strong><small>{{ project.cost_mode == 'money' ? 'Custo financeiro' : 'Contabilização por horas' }}</small></div>
    </div>
  </section>

  <nav class="pf-workspace-nav pf-workspace-nav-v3" id="pf-workspace-tabs">
    <button class="is-active" data-pf-tab="overview"><i class="ti ti-home"></i> Resumo</button>
    <button data-pf-tab="execution"><i class="ti ti-layout-kanban"></i> Execução <span>{{ tasks|length }}</span></button>
    <button data-pf-tab="schedule"><i class="ti ti-calendar-stats"></i> Cronograma</button>
    <button data-pf-tab="hours"><i class="ti ti-{{ project.cost_mode == 'money' and project.can_view_money ? 'wallet' : 'clock-hour-4' }}"></i> {{ project.cost_mode == 'money' and project.can_view_money ? 'Financeiro' : 'Horas' }}</button>
    <button data-pf-tab="meetings"><i class="ti ti-users"></i> Reuniões <span>{{ project.meetings|length }}</span></button>
    <button data-pf-tab="weekly"><i class="ti ti-report"></i> Relatório semanal</button>
    <button data-pf-tab="team"><i class="ti ti-users-group"></i> Equipe <span>{{ project.team|length }}</span></button>
    <button data-pf-tab="files"><i class="ti ti-folder"></i> Arquivos</button>
  </nav>

  <main class="pf-workspace-content">
    <section class="pf-tab-pane is-active" data-pf-pane="overview">
      <div class="pf-overview-v3">
        <section class="pf-panel pf-overview-main">
          <div class="pf-panel-header"><div><div class="pf-eyebrow">STATUS DO PROJETO</div><h2>Visão rápida</h2></div><span class="pf-health pf-health-{{ project.health_effective }}"><i></i>{{ project.health_effective == 'good' ? 'Saudável' : (project.health_effective == 'attention' ? 'Atenção' : 'Crítico') }}</span></div>
          <div class="pf-kpi-grid pf-kpi-grid-mini">
            <div><span>Tarefas</span><strong>{{ task_stats.total }}</strong></div><div><span>Concluídas</span><strong>{{ task_stats.completed }}</strong></div><div><span>Em atraso</span><strong>{{ task_stats.overdue }}</strong></div><div><span>Pontos de atenção</span><strong>{{ task_stats.attention }}</strong></div>
          </div>
          <div class="pf-project-description"><strong>Objetivo</strong><p>{{ project.objective ?: project.content ?: 'Não informado.' }}</p></div>
          {% if task_stats.attention %}
            <div class="pf-attention-list"><h3><i class="ti ti-alert-triangle"></i> Pontos de atenção abertos</h3>{% for task in tasks %}{% if task.attention %}<a href="{{ task.task_url }}"><span>{{ task.name }}</span><small>{{ task.attention_note ?: 'Marcada para atenção' }}</small></a>{% endif %}{% endfor %}</div>
          {% endif %}
        </section>
        <aside class="pf-overview-side">
          <section class="pf-panel"><div class="pf-panel-header"><h3>Próximas entregas</h3><button class="btn btn-sm btn-ghost-secondary" data-pf-goto="execution">Ver execução</button></div>{% for task in upcoming_tasks %}<a class="pf-next-task" href="{{ task.task_url }}"><div><strong>{{ task.name }}</strong><span>{{ task.state.name }} · {{ task.percent_done }}%</span></div><time class="{{ task.is_overdue ? 'pf-text-danger' : '' }}">{{ task.plan_end_date ? task.plan_end_date|date('d/m') : '—' }}</time></a>{% else %}<div class="pf-empty-inline">Nenhuma tarefa ativa.</div>{% endfor %}</section>
          <section class="pf-panel"><div class="pf-panel-header"><h3>Governança</h3></div><dl class="pf-detail-list"><div><dt>Patrocinador</dt><dd>{{ project.sponsor ?: 'Não definido' }}</dd></div><div><dt>Portfólio</dt><dd>{{ project.portfolio ?: 'Não definido' }}</dd></div><div><dt>Risco</dt><dd>{{ project.risk_level|capitalize }}</dd></div><div><dt>Contrato</dt><dd>{{ project.contracts|length ? project.contracts[0].name : 'Não vinculado' }}</dd></div></dl></section>
        </aside>
      </div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="execution">
      <div class="pf-board-toolbar">
        <div><div class="pf-eyebrow">CENTRAL DE EXECUÇÃO</div><h2>Fluxo do trabalho</h2><p>As tarefas nascem no estado inicial configurado. Ao mover um card, o percentual acompanha a coluna.</p></div>
        <div class="pf-toolbar-actions"><div class="pf-search pf-search-sm"><i class="ti ti-search"></i><input id="pf-board-search" class="form-control" placeholder="Buscar tarefa..."></div>{% if project.can_update %}<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#pf-task-create-modal"><i class="ti ti-plus"></i> Nova tarefa</button>{% endif %}</div>
      </div>
      <div class="pf-board" id="pf-board-container">
        {% for column in board %}
        <section class="pf-board-column" data-state-id="{{ column.id }}" data-progress="{{ column.progress|default(0) }}">
          <header><div><span class="pf-column-dot" style="--pf-state-color:{{ column.color }}"></span><strong>{{ column.name }}</strong></div><div class="pf-column-head-right"><span class="pf-column-progress">{{ column.progress|default(0) }}%</span><span class="pf-column-count">{{ column.tasks|length }}</span></div></header>
          <div class="pf-dropzone" data-state-id="{{ column.id }}" data-progress="{{ column.progress|default(0) }}">
          {% for task in column.tasks %}
            <article class="pf-task-card {{ task.can_update ? 'pf-task-draggable' : '' }} {{ task.attention ? 'has-attention' : '' }}" draggable="{{ task.can_update ? 'true' : 'false' }}" data-task-id="{{ task.id }}" data-search="{{ (task.name ~ ' ' ~ task.priority_name ~ ' ' ~ task.type_name)|lower }}">
              <div class="pf-task-card-top"><span>#{{ task.id }}{% if task.type_name %} · {{ task.type_name }}{% endif %}</span><span class="pf-priority-dot pf-priority-{{ task.priority }}" title="{{ task.priority_name }}"></span></div>
              <a class="pf-task-title" href="{{ task.task_url }}">{{ task.name }}</a>
              {% if task.attention %}<div class="pf-card-attention"><i class="ti ti-alert-triangle"></i>{{ task.attention_note ?: 'Ponto de atenção' }}</div>{% endif %}
              {% if task.team_summary %}<div class="pf-task-actors">{% for member in task.team_summary %}<span class="pf-avatar" title="{{ member.name }}">{{ member.name|slice(0,1)|upper }}</span>{% endfor %}</div>{% endif %}
              <div class="pf-task-progress"><span style="width:{{ task.percent_done }}%"></span></div>
              <div class="pf-task-card-foot"><span>{{ task.percent_done }}%</span><span class="{{ task.is_overdue ? 'pf-text-danger' : '' }}"><i class="ti ti-calendar"></i>{{ task.plan_end_date ? task.plan_end_date|date('d/m') : 'Sem prazo' }}</span>{% if task.reminder_due %}<i class="ti ti-bell-ringing pf-text-danger" title="Lembrete vencido"></i>{% endif %}{% if task.is_milestone %}<i class="ti ti-diamond"></i>{% endif %}</div>
            </article>
          {% endfor %}
          </div>
        </section>
        {% else %}<div class="pf-empty-state"><i class="ti ti-columns-off"></i><strong>Nenhum estado configurado</strong><p>Cadastre estados no GLPI e defina o estado inicial nas configurações do Project Flow.</p></div>{% endfor %}
      </div>
      <section class="pf-panel mt-3"><div class="pf-panel-header"><div><div class="pf-eyebrow">LISTA</div><h3>Todas as tarefas</h3></div></div><div class="table-responsive"><table class="table pf-table"><thead><tr><th>Tarefa</th><th>Estado</th><th>Prioridade</th><th>Progresso</th><th>Prazo</th><th>Execução</th></tr></thead><tbody>{% for task in tasks %}<tr><td><a href="{{ task.task_url }}"><strong>{{ task.name }}</strong></a>{% if task.attention %}<span class="pf-mini-attention"><i class="ti ti-alert-triangle"></i></span>{% endif %}</td><td>{{ task.state.name }}</td><td>{{ task.priority_name }}</td><td>{{ task.percent_done }}%</td><td class="{{ task.is_overdue ? 'pf-text-danger' : '' }}">{{ task.plan_end_date ? task.plan_end_date|date('d/m/Y') : '—' }}</td><td><a class="btn btn-sm btn-outline-primary" href="{{ task.task_url }}">Abrir</a></td></tr>{% else %}<tr><td colspan="6" class="text-muted">Nenhuma tarefa.</td></tr>{% endfor %}</tbody></table></div></section>
    </section>

    <section class="pf-tab-pane" data-pf-pane="schedule">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">SPRINTS SEMANAIS</div><h2>Cronograma</h2><p>Organização semanal a partir das datas planejadas das tarefas.</p></div></div>
      <div class="pf-sprint-list">{% for sprint in sprints %}<section class="pf-panel pf-sprint-card"><header><div><strong>{{ sprint.label }}</strong><span>{{ sprint.tasks|length }} tarefa(s)</span></div><b>{{ sprint.completed }}/{{ sprint.tasks|length }}</b></header><div class="pf-sprint-tasks">{% for task in sprint.tasks %}<a href="{{ task.task_url }}" class="{{ task.is_overdue ? 'is-overdue' : '' }}"><span class="pf-column-dot" style="--pf-state-color:{{ task.state.color }}"></span><div><strong>{{ task.name }}</strong><small>{{ task.state.name }} · {{ task.percent_done }}%</small></div><time>{{ task.plan_end_date ? task.plan_end_date|date('d/m') : '—' }}</time></a>{% endfor %}</div></section>{% else %}<div class="pf-empty-state">Sem tarefas planejadas.</div>{% endfor %}</div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="hours">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">{{ project.cost_mode == 'money' and project.can_view_money ? 'CONTROLE FINANCEIRO' : 'ESFORÇO' }}</div><h2>{{ project.cost_mode == 'money' and project.can_view_money ? 'Financeiro e horas operacionais' : 'Horas do projeto' }}</h2><p>{{ project.cost_mode == 'money' and project.can_view_money ? 'Custos financeiros ficam separados das horas operacionais de execução e reuniões.' : 'Execução e alinhamentos são contabilizados separadamente.' }}</p></div></div>
      <div class="pf-hour-kpis"><div><i class="ti ti-tool"></i><span>Execução</span><strong>{{ project.hours.execution_label }}</strong></div><div><i class="ti ti-users"></i><span>Reuniões</span><strong>{{ project.hours.meeting_label }}</strong></div><div class="is-total"><i class="ti ti-clock-hour-4"></i><span>Total</span><strong>{{ project.hours.total_label }}</strong></div>{% if project.hours_budget.minutes %}<div class="{{ project.hours_budget.overrun_minutes ? 'is-overrun' : '' }}"><i class="ti ti-hourglass"></i><span>Saldo de horas</span><strong>{{ project.hours_budget.overrun_minutes ? '-' ~ project.hours_budget.overrun_label : project.hours_budget.remaining_label }}</strong><small>{{ project.hours_budget.consumed_percent }}% de {{ project.hours_budget.label }}</small></div>{% endif %}</div>
      <section class="pf-panel mt-3"><div class="pf-panel-header"><h3>Lançamentos recentes</h3><span>Horas de execução são lançadas dentro da tarefa.</span></div><div class="table-responsive"><table class="table pf-table"><thead><tr><th>Data</th><th>Tipo</th><th>Profissional</th><th>Duração</th><th>Descrição</th></tr></thead><tbody>{% for log in project.worklogs %}<tr><td>{{ log.work_date|date('d/m/Y') }}</td><td>{{ log.work_type == 'meeting' ? 'Reunião' : 'Execução' }}</td><td>{{ log.user_name }}</td><td><strong>{{ log.duration_label }}</strong></td><td>{{ log.comment ?: '—' }}</td></tr>{% else %}<tr><td colspan="5" class="text-muted">Nenhuma hora registrada.</td></tr>{% endfor %}</tbody></table></div></section>
      {% if project.cost_mode == 'money' and project.can_view_money %}<section class="pf-panel mt-3"><div class="pf-panel-header"><div><div class="pf-eyebrow">VISÃO GERENCIAL</div><h3>Financeiro</h3></div><strong>{{ project.costs.total_formatted }}</strong></div><p class="text-muted">Esta área é mostrada apenas quando o projeto foi configurado para controle monetário e o usuário possui acesso gerencial.</p>{% if project.can_add_cost %}<form class="pf-inline-form pf-cost-form"><input type="hidden" name="project_id" value="{{ project.id }}"><input name="name" class="form-control" placeholder="Descrição"><input name="cost" class="form-control" placeholder="Valor"><button class="btn btn-outline-primary">Adicionar</button></form>{% endif %}</section>{% endif %}
    </section>

    <section class="pf-tab-pane" data-pf-pane="meetings">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">ALINHAMENTOS</div><h2>Reuniões</h2><p>Reunião não é tarefa. Registre aqui tempo, decisões e pendências.</p></div>{% if project.can_update %}<button class="btn btn-primary pf-meeting-new" data-bs-toggle="modal" data-bs-target="#pf-meeting-modal"><i class="ti ti-plus"></i> Nova reunião</button>{% endif %}</div>
      <div class="pf-meeting-list" id="pf-meeting-list">{% for meeting in project.meetings %}<article class="pf-panel pf-meeting-card"><div class="pf-meeting-date"><strong>{{ meeting.start_at|date('d') }}</strong><span>{{ meeting.start_at|date('M') }}</span></div><div class="pf-meeting-body"><header><div><h3>{{ meeting.title }}</h3><span>{{ meeting.start_at|date('d/m/Y H:i') }} · {{ meeting.duration_label }} · {{ meeting.user_name }}</span></div>{% if project.can_update %}<div class="pf-meeting-actions"><button class="btn btn-sm btn-ghost-secondary pf-meeting-edit" type="button" data-bs-toggle="modal" data-bs-target="#pf-meeting-modal" data-id="{{ meeting.id }}" data-title="{{ meeting.title|e('html_attr') }}" data-start="{{ meeting.start_at|date('Y-m-d\\TH:i') }}" data-duration="{{ meeting.duration_minutes }}" data-participants="{{ meeting.participants|e('html_attr') }}" data-summary="{{ meeting.summary|e('html_attr') }}" data-decisions="{{ meeting.decisions|e('html_attr') }}" data-actions="{{ meeting.actions|e('html_attr') }}"><i class="ti ti-edit"></i></button><button class="btn btn-sm btn-ghost-danger pf-meeting-delete" type="button" data-id="{{ meeting.id }}"><i class="ti ti-trash"></i></button></div>{% endif %}</header>{% if meeting.participants %}<p><strong>Participantes:</strong> {{ meeting.participants }}</p>{% endif %}{% if meeting.summary %}<p><strong>Resumo:</strong> {{ meeting.summary }}</p>{% endif %}{% if meeting.decisions %}<p><strong>Decisões:</strong> {{ meeting.decisions }}</p>{% endif %}{% if meeting.actions %}<p><strong>Pendências:</strong> {{ meeting.actions }}</p>{% endif %}</div></article>{% else %}<div class="pf-empty-state"><i class="ti ti-calendar-off"></i><strong>Nenhuma reunião registrada</strong><p>Use esta área para separar alinhamentos da execução técnica.</p></div>{% endfor %}</div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="weekly">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">CLIENTE</div><h2>Relatório semanal</h2><p>Consolida automaticamente tarefas, atividades, pontos de atenção, reuniões e horas da semana.</p></div></div>
      <div class="pf-report-toolbar"><select class="form-select" id="pf-report-week">{% for week in weeks %}<option value="{{ week.start }}">{{ week.label }}</option>{% endfor %}</select><button class="btn btn-primary" id="pf-report-generate"><i class="ti ti-refresh"></i> Gerar</button><button class="btn btn-outline-secondary" id="pf-report-copy"><i class="ti ti-copy"></i> Copiar</button>{% if project.can_update %}<button class="btn btn-outline-primary" id="pf-report-save"><i class="ti ti-device-floppy"></i> Salvar versão</button>{% endif %}</div>
      <section class="pf-panel pf-report-paper"><textarea id="pf-weekly-report-text" class="form-control" data-pf-lazy="1" placeholder="Selecione a semana e clique em Gerar. O relatório é montado automaticamente ao abrir esta aba.">{{ weekly_report.text }}</textarea></section>
      {% if saved_reports %}<section class="pf-panel mt-3"><div class="pf-panel-header"><h3>Versões salvas</h3></div><div class="pf-saved-reports">{% for report in saved_reports %}<button type="button" data-report-content="{{ report.content|e('html_attr') }}"><strong>{{ report.week_start|date('d/m') }} - {{ report.week_end|date('d/m/Y') }}</strong><span>{{ report.date_generation|date('d/m/Y H:i') }} · {{ report.user_name }}</span></button>{% endfor %}</div></section>{% endif %}
    </section>

    <section class="pf-tab-pane" data-pf-pane="team">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">PESSOAS</div><h2>Equipe do projeto</h2><p>Ao atribuir alguém a uma tarefa, a pessoa entra automaticamente nesta equipe.</p></div></div>
      {% if project.can_update %}<form class="pf-inline-form pf-team-add-form"><input type="hidden" name="project_id" value="{{ project.id }}"><select name="itemtype" class="form-select pf-member-type"><option value="User">Usuário</option><option value="Group">Grupo</option><option value="Supplier">Fornecedor</option><option value="Contact">Contato</option></select><select name="items_id" class="form-select pf-member-select"><option value="">Selecione...</option>{% for user in users %}<option data-kind="User" value="{{ user.id }}">{{ user.name }}</option>{% endfor %}{% for group in groups %}<option data-kind="Group" value="{{ group.id }}">{{ group.name }}</option>{% endfor %}{% for supplier in suppliers %}<option data-kind="Supplier" value="{{ supplier.id }}">{{ supplier.name }}</option>{% endfor %}{% for contact in contacts %}<option data-kind="Contact" value="{{ contact.id }}">{{ contact.name }}</option>{% endfor %}</select><button class="btn btn-primary"><i class="ti ti-user-plus"></i> Adicionar</button></form>{% endif %}
      <div class="pf-team-grid">{% for member in project.team %}<article class="pf-panel pf-team-card"><span class="pf-avatar pf-avatar-lg">{{ member.name|slice(0,1)|upper }}</span><div><strong>{{ member.name }}</strong><span>{{ member.type_label }}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-team-remove" data-id="{{ member.relation_id }}"><i class="ti ti-x"></i></button>{% endif %}</article>{% else %}<div class="pf-empty-state">Equipe ainda não definida.</div>{% endfor %}</div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="files">
      <div class="pf-files-grid">
        <section class="pf-panel"><div class="pf-panel-header"><div><div class="pf-eyebrow">CONTRATO</div><h2>Contrato do cliente</h2></div></div>
          {% if project.can_update %}<form class="pf-inline-form pf-contract-form"><input type="hidden" name="project_id" value="{{ project.id }}"><select name="contract_id" class="form-select"><option value="">Selecione um contrato existente...</option>{% for contract in contracts %}<option value="{{ contract.id }}">{{ contract.name }}{% if contract.number %} · {{ contract.number }}{% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary">Vincular</button></form>{% endif %}
          <div class="pf-contract-list">{% for contract in project.contracts %}<div class="pf-linked-item"><i class="ti ti-file-certificate"></i><div><a href="{{ contract.url }}"><strong>{{ contract.name }}</strong></a><span>{{ contract.number ?: 'Sem número' }}{% if contract.begin_date %} · {{ contract.begin_date|date('d/m/Y') }}{% endif %}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-contract-unlink" data-id="{{ contract.relation_id }}"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum contrato vinculado.</div>{% endfor %}</div>
        </section>
        <section class="pf-panel"><div class="pf-panel-header"><div><div class="pf-eyebrow">DOCUMENTOS</div><h2>Arquivos do projeto</h2></div><span>{{ project.documents|length }}</span></div>
          {% if project.can_add_document %}<form class="pf-document-upload" data-itemtype="Project" data-items-id="{{ project.id }}"><input type="file" name="file" class="form-control" required><button class="btn btn-outline-primary"><i class="ti ti-upload"></i> Anexar</button></form>{% endif %}
          <div class="pf-document-list">{% for doc in project.documents %}<div class="pf-linked-item"><i class="ti ti-file"></i><div><a href="{{ doc.url }}"><strong>{{ doc.name }}</strong></a><span>{{ doc.filename ?: 'Documento GLPI' }}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-document-unlink" data-itemtype="Project" data-items-id="{{ project.id }}" data-id="{{ doc.relation_id }}"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum documento anexado.</div>{% endfor %}</div>
        </section>
      </div>
    </section>
  </main>

  {% if project.can_update %}
  <div class="modal fade" id="pf-task-create-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="pf-task-create-form">
    <div class="modal-header"><div><div class="pf-eyebrow">EXECUÇÃO</div><h2 class="modal-title">Nova tarefa</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><input type="hidden" name="project_id" value="{{ project.id }}"><div class="row g-3">
      <div class="col-12"><label class="form-label">Título *</label><input name="name" class="form-control" required maxlength="255"></div>
      <div class="col-md-3"><label class="form-label">Estado *</label><select name="projectstates_id" class="form-select" required>{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_task_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == 3 ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Solicitado por</label><select name="requester_users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}" {{ user.id == current_user_id ? 'selected' : '' }}>{{ user.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Executor</label><select name="assignee_user_id" class="form-select"><option value="0">Definir depois</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select></div>
      <div class="col-md-4"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" class="form-control"></div><div class="col-md-4"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" class="form-control"></div><div class="col-md-4"><label class="form-label">Horas planejadas</label><input type="number" min="0" step="0.25" name="planned_duration_hours" class="form-control"></div>
      <div class="col-md-6"><label class="form-label">Tipo</label><select name="projecttasktypes_id" class="form-select"><option value="0">Não definido</option>{% for type in task_types %}<option value="{{ type.id }}">{{ type.name }}</option>{% endfor %}</select></div><div class="col-md-6 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" name="is_milestone" value="1"><span class="form-check-label">Marco do projeto</span></label></div>
      <div class="col-12"><label class="form-label">Descrição</label><textarea name="content" class="form-control" rows="3"></textarea></div>
      {% if project.execution_mode == 'ticket' %}<div class="col-md-4"><label class="form-label">Tipo do chamado</label><select name="ticket_type" class="form-select"><option value="2">Requisição</option><option value="1">Incidente</option></select></div><div class="col-md-8"><label class="form-label">Categoria do chamado</label><select name="itilcategories_id" class="form-select"><option value="0">Não definida</option>{% for c in ticket_categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></div>{% endif %}
      <div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" name="attention" value="1"><span class="form-check-label">Marcar como ponto de atenção</span></label></div>
      <div class="col-12"><input name="attention_note" class="form-control" placeholder="Motivo do ponto de atenção (opcional)"></div>
    </div><div class="pf-form-message"></div></div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit"><i class="ti ti-check"></i> Criar tarefa</button></div>
  </form></div></div></div>

  <div class="modal fade" id="pf-meeting-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="pf-meeting-form"><div class="modal-header"><div><div class="pf-eyebrow">ALINHAMENTO</div><h2 class="modal-title" id="pf-meeting-modal-title">Registrar reunião</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="project_id" value="{{ project.id }}"><input type="hidden" name="meeting_id" value="0"><div class="row g-3"><div class="col-md-8"><label class="form-label">Título *</label><input name="title" required class="form-control"></div><div class="col-md-4"><label class="form-label">Data e hora *</label><input type="datetime-local" name="start_at" required class="form-control"></div><div class="col-md-4"><label class="form-label">Duração (min) *</label><input type="number" min="1" max="1440" name="duration_minutes" value="60" class="form-control"></div><div class="col-md-8"><label class="form-label">Participantes</label><input name="participants" class="form-control" placeholder="Nomes, grupos ou cliente"></div><div class="col-12"><label class="form-label">Resumo</label><textarea name="summary" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Decisões</label><textarea name="decisions" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Pendências / ações</label><textarea name="actions" class="form-control" rows="3"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" id="pf-meeting-submit">Registrar reunião</button></div></form></div></div></div>

  <div class="modal fade" id="pf-contract-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="pf-eyebrow">CONTRATO</div><h2 class="modal-title">Contrato do projeto</h2><p class="mb-0 text-muted">Vincule o contrato da empresa/cliente a este projeto.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
    <div class="pf-contract-list mb-3">{% for contract in project.contracts %}<div class="pf-linked-item"><i class="ti ti-file-certificate"></i><div><a href="{{ contract.url }}"><strong>{{ contract.name }}</strong></a><span>{{ contract.number ?: 'Sem número' }}{% if contract.begin_date %} · {{ contract.begin_date|date('d/m/Y') }}{% endif %}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-contract-unlink" data-id="{{ contract.relation_id }}"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum contrato vinculado ao projeto.</div>{% endfor %}</div>
    {% if project.can_update %}<form class="pf-contract-form"><input type="hidden" name="project_id" value="{{ project.id }}"><label class="form-label">Vincular contrato existente</label><div class="pf-inline-form"><select name="contract_id" class="form-select" required><option value="">Selecione...</option>{% for contract in contracts %}<option value="{{ contract.id }}">{{ contract.name }}{% if contract.number %} · {{ contract.number }}{% endif %}</option>{% endfor %}</select><button class="btn btn-primary"><i class="ti ti-link"></i> Vincular</button></div></form>{% endif %}
  </div></div></div></div>

  <div class="modal fade" id="pf-project-edit-modal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><form id="pf-project-edit-form"><div class="modal-header"><div><div class="pf-eyebrow">CONFIGURAÇÕES</div><h2 class="modal-title">Projeto</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" value="{{ project.id }}"><div class="row g-3">
    <div class="col-md-8"><label class="form-label">Nome</label><input name="name" class="form-control" value="{{ project.name }}"></div><div class="col-md-4"><label class="form-label">Código</label><input name="code" class="form-control" value="{{ project.code }}"></div>
    <div class="col-md-3"><label class="form-label">Estado *</label><select name="projectstates_id" class="form-select" required>{% for state in states %}<option value="{{ state.id }}" {{ state.id == project.state.id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == project.priority ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div>
    <div class="col-md-3"><label class="form-label">Responsável</label><select name="users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}" {{ user.id == project.manager_id ? 'selected' : '' }}>{{ user.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Grupo</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}" {{ group.id == project.group_id ? 'selected' : '' }}>{{ group.name }}</option>{% endfor %}</select></div>
    <div class="col-md-3"><label class="form-label">Modo de execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ project.execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ project.execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select></div><div class="col-md-3"><label class="form-label">Contabilização</label><select name="cost_mode" class="form-select pf-project-cost-mode"><option value="hours" {{ project.cost_mode == 'hours' ? 'selected' : '' }}>Horas</option><option value="money" {{ project.cost_mode == 'money' ? 'selected' : '' }}>Custo financeiro</option></select></div><div class="col-md-3 pf-hours-budget-wrap"><label class="form-label">Horas previstas / contratadas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" value="{{ (project.hours_budget_minutes / 60)|number_format(2, '.', '') }}"><small class="text-muted">Usado quando a contabilização é por horas.</small></div>
    <div class="col-md-3"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" value="{{ project.plan_start_date ? project.plan_start_date|date('Y-m-d\\TH:i') : '' }}" class="form-control"></div><div class="col-md-3"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" value="{{ project.plan_end_date ? project.plan_end_date|date('Y-m-d\\TH:i') : '' }}" class="form-control"></div>
    <div class="col-md-3"><label class="form-label">Saúde</label><select name="health" class="form-select"><option value="auto" {{ project.health_configured == 'auto' ? 'selected' : '' }}>Automática</option><option value="good" {{ project.health_configured == 'good' ? 'selected' : '' }}>Saudável</option><option value="attention" {{ project.health_configured == 'attention' ? 'selected' : '' }}>Atenção</option><option value="critical" {{ project.health_configured == 'critical' ? 'selected' : '' }}>Crítico</option></select></div><div class="col-md-3"><label class="form-label">Risco</label><select name="risk_level" class="form-select"><option value="low" {{ project.risk_level == 'low' ? 'selected' : '' }}>Baixo</option><option value="normal" {{ project.risk_level == 'normal' ? 'selected' : '' }}>Normal</option><option value="high" {{ project.risk_level == 'high' ? 'selected' : '' }}>Alto</option><option value="critical" {{ project.risk_level == 'critical' ? 'selected' : '' }}>Crítico</option></select></div><div class="col-md-3"><label class="form-label">Portfólio</label><input name="portfolio" value="{{ project.portfolio }}" class="form-control"></div><div class="col-md-3"><label class="form-label">Patrocinador</label><input name="sponsor" value="{{ project.sponsor }}" class="form-control"></div>
    <div class="col-12"><label class="form-label">Objetivo</label><textarea name="objective" class="form-control" rows="2">{{ project.objective }}</textarea></div><div class="col-12"><label class="form-label">Descrição</label><textarea name="content" class="form-control" rows="3">{{ project.content }}</textarea></div>
  </div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Salvar</button></div></form></div></div></div>
  {% endif %}
</div>
