<div class="pf-app {{ compact_cards ? 'pf-compact' : '' }}" id="projectflow-workspace"
 data-project-id="{{ project.id }}" data-task-endpoint="{{ ajax_task_url }}" data-project-endpoint="{{ ajax_project_url }}"
 data-document-endpoint="{{ ajax_document_url }}" data-csrf="{{ csrf_token }}">

  <section class="pf-project-hero pf-project-hero-v3">
    <div class="pf-breadcrumb-row">
      {% if project.is_template %}<a href="{{ templates_url }}"><i class="ti ti-arrow-left"></i> Templates</a><span>/</span>{% else %}<a href="{{ dashboard_url }}"><i class="ti ti-arrow-left"></i> Projetos</a><span>/</span>{% endif %}
      <span>{{ project.code ?: 'PROJ-' ~ project.id }}</span>{% if project.portfolio %}<span>/</span><span>{{ project.portfolio }}</span>{% endif %}
    </div>
    <div class="pf-project-title-row">
      <div class="pf-project-heading">
        <div class="pf-title-with-state">
          <h1>{{ project.is_template and project.template_name ? project.template_name : project.name }}</h1>
          {% if project.is_template %}<span class="pf-template-badge" title="As tarefas, equipe e configurações deste template são copiadas para cada projeto criado a partir dele."><i class="ti ti-template"></i> Template</span>{% endif %}
          <span class="pf-state-badge" style="--pf-state-color:{{ project.state.color }}"><i></i>{{ project.state.name }}</span>{% if project.is_paused %}<span class="pf-paused-badge" title="Projeto pausado: lembretes, avisos das regras e notificações do GLPI estão suspensos"><i class="ti ti-player-pause"></i> Pausado</span>{% endif %}
          <span class="pf-priority-badge pf-priority-{{ project.priority }}"><i class="ti ti-flag"></i>{{ project.priority_name }}</span>
          {% if task_stats.attention %}<span class="pf-attention-badge"><i class="ti ti-alert-triangle"></i>{{ task_stats.attention }} atenção</span>{% endif %}
        </div>
        <p>{{ project.objective ?: (project.content ?: 'Projeto sem objetivo executivo cadastrado.') }}</p>
      </div>
      <div class="pf-hero-actions pf-hero-actions-compact">
        {% if project.can_update %}<div class="dropdown pf-new-task-menu"><button type="button" class="btn btn-primary pf-project-shortcut dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-plus"></i> Nova tarefa</button><div class="dropdown-menu dropdown-menu-end"><button type="button" class="dropdown-item" data-pf-new-task="parent" data-bs-toggle="modal" data-bs-target="#pf-task-create-modal"><i class="ti ti-list-check"></i> Tarefa pai</button><button type="button" class="dropdown-item" data-pf-new-task="child" data-bs-toggle="modal" data-bs-target="#pf-task-create-modal" {{ tasks ? '' : 'disabled title="Crie uma tarefa pai primeiro"' }}><i class="ti ti-subtask"></i> Tarefa filha (subtarefa)</button></div></div>{% endif %}
        {% if project.contracts %}<button type="button" class="btn btn-outline-secondary pf-project-shortcut pf-contract-open is-linked" data-bs-toggle="modal" data-bs-target="#pf-contract-viewer" title="Abrir o contrato vinculado"><i class="ti ti-file-certificate"></i> Contrato <span class="pf-contract-dot" aria-hidden="true"></span></button>{% elseif project.can_update %}<button type="button" class="btn btn-outline-secondary pf-project-shortcut" data-bs-toggle="modal" data-bs-target="#pf-contract-modal" title="Vincular um contrato ao projeto"><i class="ti ti-file-plus"></i> Vincular contrato</button>{% else %}<button type="button" class="btn btn-outline-secondary pf-project-shortcut" disabled title="Nenhum contrato vinculado"><i class="ti ti-file-certificate"></i> Sem contrato</button>{% endif %}
        {% if project.can_update %}<button type="button" class="btn btn-outline-secondary pf-icon-btn" data-bs-toggle="modal" data-bs-target="#pf-project-edit-modal" title="Configurações do projeto"><i class="ti ti-settings"></i></button>{% endif %}
        <button type="button" class="btn btn-outline-secondary pf-icon-btn pf-favorite {{ project.is_favorite ? 'is-active' : '' }}" data-project-id="{{ project.id }}" title="Favoritar projeto"><i class="ti ti-star{{ project.is_favorite ? '-filled' : '' }}"></i></button>
      </div>
    </div>

    <div class="pf-project-pulse">
      <div><span>Responsável</span><strong>{{ project.manager_name }}</strong></div>
      <div><span>Prazo</span><strong class="{{ project.is_overdue ? 'pf-text-danger' : '' }}">{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : 'Não definido' }}</strong></div>
      <div><span>Progresso</span><strong>{{ project.percent_done }}%</strong><div class="progress pf-progress"><div class="progress-bar" style="width:{{ project.percent_done }}%"></div></div></div>
      {% if project.has_hours or not project.can_view_money %}<div><span>Horas</span><strong>{{ project.hours.total_label }}{% if project.hours_budget.minutes %} / {{ project.hours_budget.label }}{% endif %}</strong><small>{{ project.hours.execution_label }} execução · {{ project.hours.meeting_label }} reunião{% if project.hours_budget.minutes %} · {{ project.hours_budget.remaining_label }} saldo{% endif %}</small></div>{% endif %}
      {% if project.has_money and project.can_view_money %}<div><span>Custo</span><strong>R$ {{ project.finance.total_formatted }}</strong><small>{% if project.finance.valued_hours %}R$ {{ project.finance.hours_value_formatted }} em horas · R$ {{ project.finance.extra_total_formatted }} avulsos{% else %}Lançamentos financeiros do projeto{% endif %}</small></div>{% endif %}
      <div><span>Modo</span><strong>{{ project.execution_mode == 'ticket' ? 'Tarefa + chamado' : 'Tarefa direta' }}</strong><small>{{ project.cost_mode_label }}{% if project.finance.valued_hours and project.can_view_money %} · R$ {{ project.finance.rate_formatted }}/h{% endif %}</small></div>
    </div>
  </section>

  <nav class="pf-workspace-nav pf-workspace-nav-v3" id="pf-workspace-tabs">
    <button class="is-active" data-pf-tab="overview"><i class="ti ti-home"></i> Resumo</button>
    <button data-pf-tab="execution"><i class="ti ti-layout-kanban"></i> Execução <span>{{ tasks|length }}</span></button>
    <button data-pf-tab="schedule"><i class="ti ti-calendar-stats"></i> Cronograma</button>
    <button data-pf-tab="hours"><i class="ti ti-{{ project.has_money and project.can_view_money ? 'wallet' : 'clock-hour-4' }}"></i> {{ project.cost_mode == 'both' and project.can_view_money ? 'Horas e custos' : (project.has_money and project.can_view_money ? 'Financeiro' : 'Horas') }}</button>
    {% if project.cost_approvals is not null %}<button data-pf-tab="approvals" title="Custos lançados nas tarefas: aprovar ou recusar antes de entrarem no financeiro"><i class="ti ti-currency-dollar"></i> Aprovações{% if project.cost_approvals.pending %} <span class="pf-tab-alert">{{ project.cost_approvals.pending }}</span>{% endif %}</button>{% endif %}
    <button data-pf-tab="meetings"><i class="ti ti-users"></i> Reuniões <span>{{ project.meetings|length }}</span></button>
    <button data-pf-tab="weekly"><i class="ti ti-report"></i> Relatório semanal</button>
    <button data-pf-tab="team"><i class="ti ti-users-group"></i> Equipe <span>{{ project.team|length }}</span></button>
    {% if not project.is_template %}<button data-pf-tab="workload" title="Carga de trabalho da equipe: horas planejadas x capacidade, incluindo outros projetos"><i class="ti ti-chart-bar"></i> Carga</button>{% endif %}
    <button data-pf-tab="files"><i class="ti ti-folder"></i> Arquivos</button>
  </nav>

  <main class="pf-workspace-content">
    <section class="pf-tab-pane is-active" data-pf-pane="overview">
      {% set ov = overview %}{% set pct = project.percent_done|default(0) %}
      {% set health_label = project.health_effective == 'good' ? 'Saudável' : (project.health_effective == 'attention' ? 'Atenção' : 'Crítico') %}
      <div class="pf-ov">

        <section class="pf-ov-card pf-ov-a">
          <header class="pf-ov-head"><span class="pf-ov-ico is-amber"><i class="ti ti-chart-donut-3"></i></span><h3>Andamento do projeto</h3><span class="pf-health pf-health-{{ project.health_effective }}"><i></i>{{ health_label }}</span></header>
          <div class="pf-ov-progress-body">
            <div class="pf-ov-ring" style="--pf-pct:{{ pct }}"><div><strong>{{ pct }}<small>%</small></strong><span>concluído</span></div></div>
            <div class="pf-ov-progress-info">
              <div class="pf-ov-line">
                <div class="pf-ov-line-head"><strong>{{ task_stats.completed }} de {{ task_stats.total }} tarefas concluídas</strong><span>{{ ov.open }} em aberto</span></div>
                <div class="pf-ov-mix-bar">{% for m in ov.mix %}<span style="flex:{{ m.count }} 1 0;--pf-state-color:{{ m.color }}" title="{{ m.name }}: {{ m.count }}"></span>{% else %}<span class="is-empty"></span>{% endfor %}</div>
                <div class="pf-ov-legend">{% for m in ov.mix %}<span style="--pf-state-color:{{ m.color }}"><i></i>{{ m.name }}<b>{{ m.count }}</b></span>{% endfor %}</div>
              </div>
              <div class="pf-ov-line">
                {% set pr = ov.period %}
                <div class="pf-ov-line-head"><strong>Prazo do projeto</strong><span class="{{ pr and pr.late ? 'is-danger' : '' }}">{{ pr ? pr.label : 'Período não definido' }}</span></div>
                <div class="pf-ov-time {{ pr and pr.late ? 'is-late' : '' }}">{% if pr and pr.elapsed is not null %}<span style="width:{{ pr.elapsed }}%"></span><i style="left:{{ pr.elapsed }}%"></i>{% endif %}</div>
                <div class="pf-ov-time-labels"><span>{{ pr and pr.start ? 'Início ' ~ pr.start : 'Sem início' }}</span><span>{{ pr and pr.end ? 'Prazo ' ~ pr.end : 'Sem prazo' }}</span></div>
              </div>
            </div>
          </div>
        </section>

        <section class="pf-ov-card pf-ov-b">
          <header class="pf-ov-head"><span class="pf-ov-ico is-blue"><i class="ti ti-gauge"></i></span><h3>Indicadores</h3></header>
          <div class="pf-ov-tiles">
            <button type="button" class="pf-ov-tile" data-pf-goto="execution"><span class="pf-ov-tile-top"><i class="ti ti-list-check"></i>Em aberto</span><strong>{{ ov.open }}</strong><small>de {{ task_stats.total }} tarefas</small></button>
            <button type="button" class="pf-ov-tile is-good" data-pf-goto="execution"><span class="pf-ov-tile-top"><i class="ti ti-circle-check"></i>Concluídas</span><strong>{{ task_stats.completed }}</strong><small>{{ ov.done_pct }}% das tarefas</small></button>
            <button type="button" class="pf-ov-tile {{ task_stats.overdue ? 'is-danger' : 'is-calm' }}" data-pf-goto="schedule"><span class="pf-ov-tile-top"><i class="ti ti-alarm"></i>Em atraso</span><strong>{{ task_stats.overdue }}</strong><small>{{ ov.max_late ? 'maior atraso: ' ~ ov.max_late ~ ' dia(s)' : 'nenhuma atrasada' }}</small></button>
            <button type="button" class="pf-ov-tile {{ task_stats.attention ? 'is-warning' : 'is-calm' }}" data-pf-goto="execution"><span class="pf-ov-tile-top"><i class="ti ti-alert-triangle"></i>Atenção</span><strong>{{ task_stats.attention }}</strong><small>{{ task_stats.attention ? 'pontos em aberto' : 'nenhum ponto aberto' }}</small></button>
          </div>
        </section>

        <section class="pf-ov-card pf-ov-half">
          <header class="pf-ov-head"><span class="pf-ov-ico is-red"><i class="ti ti-urgent"></i></span><h3>Precisa de atenção</h3>{% if ov.attention_total %}<em class="pf-ov-count is-danger">{{ ov.attention_total }}</em>{% endif %}</header>
          <div class="pf-ov-list">
            {% for t in ov.attention %}
              <a class="pf-ov-row-item" href="{{ t.task_url }}">
                <span class="pf-ov-lead {{ t.is_overdue ? 'is-danger' : 'is-warning' }}"><i class="ti ti-{{ t.is_overdue ? 'alarm' : 'alert-triangle' }}"></i></span>
                <span class="pf-ov-main"><strong>{{ t.name }}</strong><small>{% if t.is_overdue %}Prazo {{ t.plan_end_date|date('d/m') }}{% if t.ov_late_days %} · {{ t.ov_late_days }} dia(s) de atraso{% endif %}{% endif %}{% if t.is_overdue and t.attention %} · {% endif %}{% if t.attention %}{{ t.attention_note ?: 'Ponto de atenção' }}{% endif %}</small></span>
                <span class="pf-ov-state" style="--pf-state-color:{{ t.state.color }}">{{ t.state.name }}</span>
              </a>
            {% else %}
              <div class="pf-ov-empty is-good"><i class="ti ti-circle-check"></i><strong>Tudo em dia</strong><span>Nenhuma tarefa atrasada ou marcada como ponto de atenção.</span></div>
            {% endfor %}
          </div>
          <button type="button" class="pf-ov-foot" data-pf-goto="execution"><span>{{ ov.attention_total > ov.attention|length ? '+ ' ~ (ov.attention_total - ov.attention|length) ~ ' na execução' : 'Abrir execução' }}</span><i class="ti ti-arrow-right"></i></button>
        </section>

        <section class="pf-ov-card pf-ov-half">
          <header class="pf-ov-head"><span class="pf-ov-ico is-amber"><i class="ti ti-calendar-due"></i></span><h3>Próximas entregas</h3>{% if ov.upcoming|length %}<em class="pf-ov-count">{{ ov.upcoming|length }}</em>{% endif %}</header>
          <div class="pf-ov-list">
            {% for t in ov.upcoming %}
              <a class="pf-ov-row-item" href="{{ t.task_url }}">
                <span class="pf-ov-date {{ t.ov_days <= 2 ? 'is-soon' : '' }}"><b>{{ t.ov_day }}</b><small>{{ t.ov_month }}</small></span>
                <span class="pf-ov-main"><strong>{% if t.is_milestone %}<i class="ti ti-flag-3 pf-ov-milestone"></i>{% endif %}{{ t.name }}</strong><small>{{ t.ov_when|capitalize }} · {{ t.percent_done }}% feito</small></span>
                <span class="pf-ov-state" style="--pf-state-color:{{ t.state.color }}">{{ t.state.name }}</span>
              </a>
            {% else %}
              <div class="pf-ov-empty"><i class="ti ti-calendar-off"></i><strong>Nenhuma entrega com prazo</strong><span>Defina prazos nas tarefas para acompanhar as entregas aqui.</span></div>
            {% endfor %}
          </div>
          <button type="button" class="pf-ov-foot" data-pf-goto="schedule"><span>{{ ov.undated ? ov.undated ~ ' tarefa(s) em aberto sem prazo' : 'Abrir cronograma' }}</span><i class="ti ti-arrow-right"></i></button>
        </section>

        <section class="pf-ov-card pf-ov-third">
          <header class="pf-ov-head"><span class="pf-ov-ico is-violet"><i class="ti ti-users-group"></i></span><h3>Equipe</h3><em class="pf-ov-count">{{ project.team|length }}</em></header>
          <div class="pf-ov-list">
            {% for m in project.team|slice(0, 4) %}
              <div class="pf-ov-row-item" style="--pf-role-color:{{ m.role ? m.role.color : '#94a3b8' }}">
                <span class="pf-ov-avatar">{{ m.initials }}</span>
                <span class="pf-ov-main"><strong>{{ m.name }}{% if m.is_manager %} <i class="ti ti-crown pf-ov-crown" title="Responsável pelo projeto"></i>{% endif %}</strong><small>{{ m.role ? m.role.name : 'Sem função' }}</small></span>
                <span class="pf-ov-meta">{{ m.tasks_count }} {{ m.tasks_count == 1 ? 'tarefa' : 'tarefas' }}</span>
              </div>
            {% else %}
              <div class="pf-ov-empty"><i class="ti ti-user-plus"></i><strong>Sem equipe</strong><span>Adicione pessoas na aba Equipe.</span></div>
            {% endfor %}
          </div>
          <button type="button" class="pf-ov-foot" data-pf-goto="team"><span>{{ project.team|length > 4 ? '+ ' ~ (project.team|length - 4) ~ ' pessoa(s)' : 'Gerenciar equipe' }}</span><i class="ti ti-arrow-right"></i></button>
        </section>

        <section class="pf-ov-card pf-ov-third">
          {% set lm = ov.last_meeting %}
          <header class="pf-ov-head"><span class="pf-ov-ico is-teal"><i class="ti ti-messages"></i></span><h3>Última reunião</h3>{% if project.meetings|length %}<em class="pf-ov-count">{{ project.meetings|length }}</em>{% endif %}</header>
          <div class="pf-ov-list">
            {% if lm %}
              <div class="pf-ov-row-item"><span class="pf-ov-date"><b>{{ lm.ov_day }}</b><small>{{ lm.ov_month }}</small></span><span class="pf-ov-main"><strong>{{ lm.title }}</strong><small>{{ lm.duration_label }} · {{ lm.user_name }}</small></span></div>
              {% set note = lm.actions ?: (lm.decisions ?: lm.summary) %}
              <div class="pf-ov-quote"><span>{{ lm.actions ? 'Pendências' : (lm.decisions ? 'Decisões' : 'Resumo') }}</span><p>{{ note ?: 'Sem anotações registradas.' }}</p></div>
            {% else %}
              <div class="pf-ov-empty"><i class="ti ti-calendar-off"></i><strong>Nenhuma reunião</strong><span>Registre os alinhamentos na aba Reuniões.</span></div>
            {% endif %}
          </div>
          <button type="button" class="pf-ov-foot" data-pf-goto="meetings"><span>{{ project.meetings|length ? 'Todas as reuniões' : 'Registrar reunião' }}</span><i class="ti ti-arrow-right"></i></button>
        </section>

        <section class="pf-ov-card pf-ov-third">
          <header class="pf-ov-head"><span class="pf-ov-ico is-slate"><i class="ti ti-shield-check"></i></span><h3>Governança</h3></header>
          <div class="pf-ov-list">
            <div class="pf-ov-fact"><span><i class="ti ti-user-star"></i>Patrocinador</span><b class="{{ project.sponsor ? '' : 'is-empty' }}">{{ project.sponsor ?: 'Não definido' }}</b></div>
            <div class="pf-ov-fact"><span><i class="ti ti-briefcase"></i>Portfólio</span><b class="{{ project.portfolio ? '' : 'is-empty' }}">{{ project.portfolio ?: 'Não definido' }}</b></div>
            <div class="pf-ov-fact"><span><i class="ti ti-gauge"></i>Risco</span><b><em class="pf-ov-risk is-{{ project.risk_level }}">{{ {'low':'Baixo','normal':'Normal','high':'Alto','critical':'Crítico'}[project.risk_level]|default(project.risk_level) }}</em></b></div>
            <div class="pf-ov-fact"><span><i class="ti ti-file-certificate"></i>Contrato</span>{% if project.contracts|length %}<button type="button" class="pf-ov-link" data-bs-toggle="modal" data-bs-target="#pf-contract-viewer" title="{{ project.contracts[0].name }}">{{ project.contracts[0].name }}</button>{% else %}<b class="is-empty">Não vinculado</b>{% endif %}</div>
          </div>
          {% if project.can_update %}<button type="button" class="pf-ov-foot" data-bs-toggle="modal" data-bs-target="#pf-project-edit-modal"><span>Editar governança</span><i class="ti ti-arrow-right"></i></button>{% else %}<div class="pf-ov-foot is-static"><span>Somente leitura</span></div>{% endif %}
        </section>

      </div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="execution">
      <div class="pf-board-toolbar">
        <div><div class="pf-eyebrow">CENTRAL DE EXECUÇÃO</div><h2>Fluxo do trabalho</h2><p>As tarefas nascem no estado inicial configurado. Ao mover um card, o percentual acompanha a coluna.</p></div>
        <div class="pf-toolbar-actions"><div class="pf-search pf-search-sm"><i class="ti ti-search"></i><input id="pf-board-search" class="form-control" placeholder="Buscar tarefa..."></div><div class="btn-group pf-view-toggle" role="group" aria-label="Visualização"><button type="button" class="btn btn-sm btn-outline-secondary active" data-pf-view="kanban" aria-pressed="true"><i class="ti ti-layout-kanban"></i> Kanban</button><button type="button" class="btn btn-sm btn-outline-secondary" data-pf-view="list" aria-pressed="false"><i class="ti ti-list"></i> Lista</button></div></div>
      </div>
      <div class="pf-board" id="pf-board-container" data-pf-view-pane="kanban">
        {% for column in board %}
        <section class="pf-board-column" data-state-id="{{ column.id }}" data-progress="{{ column.progress|default(0) }}">
          <header><div><span class="pf-column-dot" style="--pf-state-color:{{ column.color }}"></span><strong>{{ column.name }}</strong></div><div class="pf-column-head-right"><span class="pf-column-progress">{{ column.progress|default(0) }}%</span><span class="pf-column-count">{{ column.tasks|length }}</span></div></header>
          <div class="pf-dropzone" data-state-id="{{ column.id }}" data-progress="{{ column.progress|default(0) }}">
          {% for task in column.tasks %}
            <article class="pf-task-card {{ task.can_update ? 'pf-task-draggable' : '' }} {{ task.attention ? 'has-attention' : '' }}" draggable="{{ task.can_update ? 'true' : 'false' }}" data-task-id="{{ task.id }}" data-allowed-states="{{ task.allowed_state_ids|join(',') }}" data-search="{{ (task.name ~ ' ' ~ task.priority_name ~ ' ' ~ task.type_name)|lower }}">
              <div class="pf-task-card-top"><span>#{{ task.id }}{% if task.type_name %} · {{ task.type_name }}{% endif %}</span><span class="pf-priority-dot pf-priority-{{ task.priority }}" title="{{ task.priority_name }}"></span></div>
              <a class="pf-task-title" href="{{ task.task_url }}">{{ task.name }}</a>
              {% if task.attention %}<div class="pf-card-attention"><i class="ti ti-alert-triangle"></i>{{ task.attention_note ?: 'Ponto de atenção' }}</div>{% endif %}
              {% if task.team_summary %}<div class="pf-task-actors">{% for member in task.team_summary %}<span class="pf-avatar" title="{{ member.name }}">{{ member.name|slice(0,1)|upper }}</span>{% endfor %}</div>{% endif %}
              <div class="pf-task-progress"><span style="width:{{ task.percent_done }}%"></span></div>
              <div class="pf-task-card-foot"><span>{{ task.percent_done }}%</span><span class="{{ task.is_overdue ? 'pf-text-danger' : '' }}"><i class="ti ti-calendar"></i>{{ task.plan_end_date ? task.plan_end_date|date('d/m') : 'Sem prazo' }}</span>{% if task.reminder_due %}<i class="ti ti-bell-ringing pf-text-danger" title="Lembrete vencido"></i>{% endif %}{% if task.is_milestone %}<i class="ti ti-diamond"></i>{% endif %}{% if task.hours.total_minutes or task.hours.planned_minutes %}<span class="pf-task-hours {{ task.hours.planned_percent is not null and task.hours.planned_percent > 100 ? 'pf-text-danger' : '' }}" title="Execução {{ task.hours.execution_label }} · Reuniões {{ task.hours.meeting_label }}{% if task.hours.planned_label %} · Previsto {{ task.hours.planned_label }}{% endif %}"><i class="ti ti-clock-hour-4"></i>{{ task.hours.total_label }}{% if task.hours.planned_label %}/{{ task.hours.planned_label }}{% endif %}</span>{% endif %}</div>
            </article>
          {% endfor %}
          </div>
        </section>
        {% else %}<div class="pf-empty-state"><i class="ti ti-columns-off"></i><strong>Nenhum estado configurado</strong><p>Cadastre estados no GLPI e defina o estado inicial nas configurações do Project Flow.</p></div>{% endfor %}
      </div>
      <section class="pf-panel mt-3 d-none" data-pf-view-pane="list"><div class="table-responsive"><table class="table pf-table" data-pf-tree data-pf-tree-key="pf-tree-{{ project.id }}"><thead><tr><th><span class="pf-tree-head">Tarefa{% if tasks_tree|filter(t => t.has_children)|length %}<span class="pf-tree-all"><button type="button" data-pf-tree-all="expand" title="Expandir todas"><i class="ti ti-chevrons-down"></i></button><button type="button" data-pf-tree-all="collapse" title="Recolher todas"><i class="ti ti-chevrons-up"></i></button></span>{% endif %}</span></th><th>Estado</th><th>Prioridade</th><th>Progresso</th><th>Prazo</th><th class="text-end">Horas</th><th></th></tr></thead><tbody>{% for task in tasks_tree %}<tr class="pf-task-row pf-tree-depth-{{ task.depth }}{{ task.has_children ? ' has-children' : '' }}" data-pf-tree-id="{{ task.id }}" data-pf-tree-parent="{{ task.parent_id|default(0) }}" data-search="{{ (task.name ~ ' ' ~ task.state.name ~ ' ' ~ task.priority_name ~ ' ' ~ task.type_name)|lower }}"><td><span class="pf-tree-cell" style="--pf-depth:{{ task.depth }}">{% if task.depth %}<i class="ti ti-corner-down-right pf-tree-elbow"></i>{% endif %}{% if task.has_children %}<button type="button" class="pf-tree-toggle" data-pf-tree-toggle aria-expanded="true" title="Ocultar subtarefas"><i class="ti ti-chevron-down"></i></button>{% else %}<span class="pf-tree-toggle-spacer"></span>{% endif %}<a href="{{ task.task_url }}"><strong>{{ task.name }}</strong></a>{% if task.has_children %}<span class="pf-tree-badge" title="Tem subtarefas"><i class="ti ti-subtask"></i></span>{% endif %}</span>{% if task.attention %}<span class="pf-mini-attention"><i class="ti ti-alert-triangle"></i></span>{% endif %}</td><td>{{ task.state.name }}</td><td>{{ task.priority_name }}</td><td>{{ task.percent_done }}%</td><td class="{{ task.is_overdue ? 'pf-text-danger' : '' }}">{{ task.plan_end_date ? task.plan_end_date|date('d/m/Y') : '—' }}</td><td class="text-end text-nowrap" title="Execução {{ task.hours.execution_label }} · Reuniões {{ task.hours.meeting_label }}">{{ task.hours.total_label }}{% if task.hours.planned_label %} <small class="text-muted">/ {{ task.hours.planned_label }}</small>{% endif %}</td><td><a class="btn btn-sm btn-outline-primary" href="{{ task.task_url }}">Abrir</a></td></tr>{% else %}<tr><td colspan="7" class="text-muted">Nenhuma tarefa ainda.{% if project.can_update %} <a href="#" data-bs-toggle="modal" data-bs-target="#pf-task-create-modal">Criar a primeira tarefa</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
    </section>

    <section class="pf-tab-pane" data-pf-pane="schedule">
      {% set sc_backlog = sprints|filter(s => s.key == 'backlog')|first %}{% set sc_overdue = tasks|filter(t => t.is_overdue)|length %}
      {% set sc_done = tasks|filter(t => t.state.is_finished or t.percent_done >= 100)|length %}
      {% set sc_next = tasks|filter(t => not t.state.is_finished and t.plan_end_date)|sort((a, b) => a.plan_end_ts <=> b.plan_end_ts)|first %}
      <div class="pf-sc-top">
        <div class="pf-sc-title"><div class="pf-eyebrow">PLANEJAMENTO</div><h2>Cronograma</h2></div>
        <div class="pf-sc-stats">
          <div class="pf-sc-stat"><i class="ti ti-calendar-event"></i><div><span>Período</span><strong>{{ timeline.has_dates ? timeline.start_label|slice(0,5) ~ ' → ' ~ timeline.end_label : 'Sem datas' }}</strong></div></div>
          <div class="pf-sc-stat"><i class="ti ti-chart-bar"></i><div><span>No cronograma</span><strong>{{ gantt.rows|length }} <small>de {{ tasks|length }} tarefas</small></strong></div></div>
          <div class="pf-sc-stat"><i class="ti ti-circle-check"></i><div><span>Concluídas</span><strong>{{ sc_done }}</strong></div></div>
          <div class="pf-sc-stat {{ sc_overdue ? 'is-danger' : '' }}"><i class="ti ti-alarm"></i><div><span>Atrasadas</span><strong>{{ sc_overdue }}</strong></div></div>
          <div class="pf-sc-stat is-wide"><i class="ti ti-flag"></i><div><span>Próxima entrega</span><strong title="{{ sc_next ? sc_next.name : '' }}">{% if sc_next %}<b>{{ sc_next.plan_end_date|date('d/m') }}</b> {{ sc_next.name }}{% else %}—{% endif %}</strong></div></div>
        </div>
      </div>

      {% if gantt.has_dates %}
      <section class="pf-gx is-view-plan" data-pf-gx style="--pf-gx-cols:{{ gantt.cols }};--pf-gx-unit:{{ gantt.mode == 'day' ? 38 : 84 }}px">
        <div class="pf-gx-toolbar">
          <div class="pf-gx-legend pf-gx-legend-plan">
            <span><i class="pf-gx-key is-bar"></i>Planejado</span>
            <span><i class="pf-gx-key is-progress"></i>Andamento</span>
            <span><i class="pf-gx-key is-late"></i>Atraso</span>
            <span><i class="pf-gx-key is-milestone"></i>Marco</span>
            {% if gantt.today_pct is not null %}<span><i class="pf-gx-key is-today"></i>Hoje · {{ gantt.today_label }}</span>{% endif %}
          </div>
          <div class="pf-gx-legend pf-gx-legend-real">
            <span><i class="pf-gx-key is-real"></i>Executado</span>
            <span><i class="pf-gx-key is-real-open"></i>Em execução (até hoje)</span>
            <span><i class="pf-gx-key is-milestone"></i>Marco entregue</span>
            {% if gantt.today_pct is not null %}<span><i class="pf-gx-key is-today"></i>Hoje · {{ gantt.today_label }}</span>{% endif %}
          </div>
          <div class="pf-gx-legend pf-gx-legend-compare">
            <span><i class="pf-gx-key is-plan-ghost"></i>Planejado</span>
            <span><i class="pf-gx-key is-real"></i>Real</span>
            <span><em class="pf-gx-var is-late">+3d</em>depois do prazo</span>
            <span><em class="pf-gx-var is-early">-2d</em>antes do prazo</span>
          </div>
          <div class="pf-gx-tools">
            <div class="pf-gx-views" role="group" aria-label="Cronograma">
              <button type="button" class="is-active" data-pf-gx-view="plan"><i class="ti ti-calendar-event"></i>Planejado</button>
              <button type="button" data-pf-gx-view="real"><i class="ti ti-player-play"></i>Real{% if gantt.real_count %} <em>{{ gantt.real_count }}</em>{% endif %}</button>
              <button type="button" data-pf-gx-view="compare"><i class="ti ti-arrows-diff"></i>Comparar</button>
            </div>
            <span class="pf-gx-mode"><i class="ti ti-zoom-in"></i>{{ gantt.mode == 'day' ? 'Visão diária' : 'Visão semanal' }}</span>
          </div>
        </div>
        <div class="pf-gx-scroll">
          <div class="pf-gx-grid">
            <div class="pf-gx-row pf-gx-months"><div class="pf-gx-label">Tarefa</div><div class="pf-gx-track">{% for m in gantt.months %}<span style="left:{{ m.left }}%;width:{{ m.width }}%" title="{{ m.label }}">{{ m.short ? '' : m.label }}</span>{% endfor %}</div></div>
            <div class="pf-gx-row pf-gx-cols"><div class="pf-gx-label"><span>{{ gantt.rows|length }} tarefa(s)</span><span>Duração</span></div><div class="pf-gx-track">{% for c in gantt.columns %}<span class="{{ c.is_weekend ? 'is-weekend' : '' }} {{ c.is_today ? 'is-today' : '' }}"><b>{{ c.label }}</b><small>{{ c.sub }}</small></span>{% endfor %}</div></div>
            <div class="pf-gx-body">
              <div class="pf-gx-bg">{% for c in gantt.columns %}<i class="{{ c.is_weekend ? 'is-weekend' : '' }} {{ c.is_week_start ? 'is-week-start' : '' }} {{ c.is_today ? 'is-today' : '' }}"></i>{% endfor %}</div>
              {% for r in gantt.rows %}
              <a class="pf-gx-row pf-gx-task {{ r.has_children ? 'is-parent' : '' }} {{ r.g_finished ? 'is-done' : '' }} {{ r.is_overdue ? 'is-overdue' : '' }} {{ r.g_has_plan ? '' : 'no-plan' }} {{ r.r_has ? '' : 'no-real' }}" href="{{ r.task_url }}" style="--pf-state-color:{{ r.state.color ?: '#4c7cf3' }}" title="{{ r.name }}{% if r.g_has_plan %} · planejado {{ r.g_range }}{% endif %}{% if r.r_has %} · real {{ r.r_range }}{% endif %} · {{ r.percent_done }}%">
                <div class="pf-gx-label" style="--pf-depth:{{ r.depth }}">
                  {% if r.depth > 0 %}<i class="ti ti-corner-down-right pf-gx-elbow"></i>{% endif %}
                  <span class="pf-column-dot" style="--pf-state-color:{{ r.state.color }}"></span>
                  <span class="pf-gx-name">{{ r.name }}</span>
                  {% if r.is_overdue and r.g_late_days > 0 %}<em class="pf-gx-late-tag pf-gx-only-plan">{{ r.g_late_days }}d atraso</em>{% endif %}
                  {% if r.r_var_days is not null %}<em class="pf-gx-var pf-gx-only-real {{ r.r_var_days > 0 ? 'is-late' : (r.r_var_days < 0 ? 'is-early' : 'is-ontime') }}" title="Fim real em relação à data limite">{{ r.r_var_days > 0 ? '+' ~ r.r_var_days ~ 'd' : (r.r_var_days < 0 ? r.r_var_days ~ 'd' : 'no prazo') }}</em>{% endif %}
                  <small class="pf-gx-only-plan">{{ r.is_milestone ? 'marco' : (r.g_has_plan ? r.g_days ~ 'd' : '—') }}</small>
                  <small class="pf-gx-only-real">{{ r.r_has ? (r.is_milestone ? 'marco' : r.r_days ~ 'd') : '—' }}</small>
                </div>
                <div class="pf-gx-track">
                  {% if r.r_has %}
                    {% if r.r_milestone %}
                      <span class="pf-gx-rmilestone" style="left:{{ r.r_left }}%"></span>
                    {% else %}
                      <span class="pf-gx-real {{ r.r_ongoing ? 'is-open' : '' }}" style="left:{{ r.r_left }}%;width:{{ r.r_width }}%">{% if not r.r_ongoing %}<b class="ti ti-check"></b>{% endif %}</span>
                    {% endif %}
                    <span class="pf-gx-cap pf-gx-rcap {{ r.r_label_left ? 'is-left' : '' }}" style="{{ r.r_label_left ? 'right:calc(' ~ (100 - r.r_left) ~ '% + 8px)' : 'left:calc(' ~ (r.r_left + r.r_width) ~ '% + ' ~ (r.r_milestone ? 16 : 8) ~ 'px)' }}">{{ r.r_range }}{% if r.r_start_var %} · início {{ r.r_start_var > 0 ? '+' ~ r.r_start_var : r.r_start_var }}d{% endif %}</span>
                  {% else %}
                    <span class="pf-gx-cap pf-gx-rcap pf-gx-none" style="left:8px">Não iniciada</span>
                  {% endif %}
                  {% if not r.g_has_plan %}<span class="pf-gx-cap pf-gx-pcap pf-gx-none" style="left:8px">Sem datas planejadas</span>{% endif %}
                  {% if r.g_late_left is not null %}<span class="pf-gx-late" style="left:{{ r.g_late_left }}%;width:{{ r.g_late_width }}%"></span>{% endif %}
                  {% if not r.g_has_plan %}
                  {% elseif r.is_milestone %}
                    <span class="pf-gx-milestone" style="left:{{ r.g_left }}%"></span>
                    <span class="pf-gx-cap pf-gx-pcap {{ r.g_label_left ? 'is-left' : '' }}" style="{{ r.g_label_left ? 'right:calc(' ~ (100 - r.g_left) ~ '% + 16px)' : 'left:calc(' ~ r.g_left ~ '% + 16px)' }}">{{ r.g_range }}</span>
                  {% else %}
                    <span class="pf-gx-bar" style="left:{{ r.g_left }}%;width:{{ r.g_width }}%"><i style="width:{{ r.percent_done }}%"></i>{% if r.g_finished %}<b class="ti ti-check"></b>{% endif %}</span>
                    {% set cap_at = r.g_late_left is not null ? r.g_late_left + r.g_late_width : r.g_left + r.g_width %}
                    <span class="pf-gx-cap pf-gx-pcap {{ r.g_label_left ? 'is-left' : '' }}" style="{{ r.g_label_left ? 'right:calc(' ~ (100 - r.g_left) ~ '% + 8px)' : 'left:calc(' ~ cap_at ~ '% + 8px)' }}"><b>{{ r.percent_done }}%</b> {{ r.g_range }}</span>
                  {% endif %}
                </div>
              </a>
              {% endfor %}
              {% if gantt.today_pct is not null %}<div class="pf-gx-today" style="--pf-today:{{ gantt.today_pct }}"></div>{% endif %}
            </div>
          </div>
        </div>
      </section>
      {% else %}
      <section class="pf-gx pf-gx-empty"><i class="ti ti-calendar-off"></i><strong>Nenhuma tarefa com início e prazo</strong><span>Defina as datas planejadas nas tarefas para montar a linha do tempo.</span></section>
      {% endif %}

      <div class="pf-sc-lower {{ sc_backlog ? '' : 'is-single' }}">
        <section class="pf-sc-agenda">
          <header class="pf-sc-sec-head"><h3><i class="ti ti-list-details"></i>Agenda por semana</h3><span>Pela semana de início (ou do prazo)</span></header>
          {% for sprint in sprints|filter(s => s.key != 'backlog') %}
            <div class="pf-sc-wk {{ sprint.is_current ? 'is-current' : '' }} {{ sprint.is_past ? 'is-past' : '' }}">
              <div class="pf-sc-wk-head">
                <strong>{{ sprint.label }}</strong>{% if sprint.is_current %}<span class="pf-sc-now">Esta semana</span>{% elseif sprint.is_past %}<span class="pf-sc-past">Passada</span>{% endif %}
                <div class="pf-sc-wk-meter"><span style="width:{{ sprint.percent }}%"></span></div><b>{{ sprint.completed }}/{{ sprint.tasks|length }}</b>
              </div>
              {% for task in sprint.tasks %}
                <a href="{{ task.task_url }}" class="pf-sc-wk-task {{ task.is_overdue ? 'is-overdue' : '' }} {{ task.state.is_finished ? 'is-done' : '' }}">
                  <time>{{ task.plan_end_date ? task.plan_end_date|date('d/m') : '—' }}</time>
                  <span class="pf-sc-task-name">{% if task.is_milestone %}<i class="ti ti-flag-3"></i>{% endif %}{{ task.name }}</span>
                  <span class="pf-sc-state" style="--pf-state-color:{{ task.state.color }}">{{ task.state.name }}</span>
                  <span class="pf-sc-pct">{{ task.percent_done }}%</span>
                </a>
              {% endfor %}
            </div>
          {% else %}
            <div class="pf-empty-inline">Nenhuma tarefa com data planejada.</div>
          {% endfor %}
        </section>
        {% if sc_backlog %}
        <aside class="pf-sc-unplanned">
          <header class="pf-sc-sec-head"><h3><i class="ti ti-calendar-question"></i>Sem planejamento <em>{{ sc_backlog.tasks|length }}</em></h3><span>Defina início e prazo para entrarem no cronograma.</span></header>
          {% for task in sc_backlog.tasks %}<a href="{{ task.task_url }}" class="{{ task.state.is_finished ? 'is-done' : '' }}"><span class="pf-column-dot" style="--pf-state-color:{{ task.state.color }}"></span><span class="pf-sc-task-name">{{ task.name }}</span><small>{{ task.state.name }}</small><i class="ti ti-chevron-right"></i></a>{% endfor %}
        </aside>
        {% endif %}
      </div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="hours">
      <div class="pf-section-heading"><div>{% set pf_fin = project.has_money and project.can_view_money %}{% set pf_valued = project.finance.valued_hours and project.can_view_money %}<div class="pf-eyebrow">{{ pf_fin ? 'HORAS E FINANCEIRO' : 'ESFORÇO' }}</div><h2>{{ pf_valued ? 'Horas valorizadas e custos' : (pf_fin ? 'Financeiro e horas operacionais' : 'Horas do projeto') }}</h2><p>{{ pf_valued ? 'Cada hora lançada (execução e reuniões) é valorizada pelo valor/hora do projeto; custos avulsos somam ao total.' : (pf_fin ? 'Custos financeiros ficam separados das horas operacionais de execução e reuniões.' : 'Execução e alinhamentos são contabilizados separadamente.') }}</p></div></div>
      {% set pf_budget = project.hours_budget %}
      <div class="pf-hk-group">
        <div class="pf-hk-group-title"><i class="ti ti-clock-hour-4"></i> Horas</div>
        <div class="pf-hk-row">
          <div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-tool"></i><span>Execução</span></div><strong>{{ project.hours.execution_label }}</strong><small>Lançadas nas tarefas</small></div>
          <div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-users"></i><span>Reuniões</span></div><strong>{{ project.hours.meeting_label }}</strong><small>Alinhamentos registrados</small></div>
          <div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-sum"></i><span>Total</span></div><strong>{{ project.hours.total_label }}</strong><small>{{ pf_budget.minutes ? 'de ' ~ pf_budget.label ~ ' previstas' : 'Sem horas previstas' }}</small></div>
          {% if pf_budget.minutes %}<div class="pf-hk {{ pf_budget.overrun_minutes ? 'is-overrun' : '' }}"><div class="pf-hk-head"><i class="ti ti-hourglass"></i><span>{{ pf_budget.overrun_minutes ? 'Excedido' : 'Saldo' }}</span></div><strong>{{ pf_budget.overrun_minutes ? pf_budget.overrun_label : pf_budget.remaining_label }}</strong><div class="pf-hk-bar {{ pf_budget.overrun_minutes ? 'is-over' : '' }}"><span style="width:{{ min(100, pf_budget.consumed_percent) }}%"></span></div><small>{{ pf_budget.consumed_percent }}% consumido</small></div>{% endif %}
        </div>
      </div>
      {% if pf_fin %}
      <div class="pf-hk-group">
        <div class="pf-hk-group-title"><i class="ti ti-wallet"></i> Financeiro</div>
        <div class="pf-hk-row">
          {% if pf_valued %}<div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-tag"></i><span>Valor por hora</span></div><strong>R$ {{ project.finance.rate_formatted }}</strong><small>{{ pf_budget.minutes ? 'Previsto: R$ ' ~ project.finance.planned_value_formatted : 'Defina horas previstas para ver o previsto' }}</small></div>
          <div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-coin"></i><span>Valor das horas</span></div><strong>R$ {{ project.finance.hours_value_formatted }}</strong><small>{{ project.hours.total_label }} × R$ {{ project.finance.rate_formatted }}</small></div>{% endif %}
          <div class="pf-hk"><div class="pf-hk-head"><i class="ti ti-receipt"></i><span>Custos avulsos</span></div><strong>R$ {{ project.finance.extra_total_formatted }}</strong><small>{{ project.costs.items|length }} lançamento(s)</small></div>
          <div class="pf-hk is-highlight"><div class="pf-hk-head"><i class="ti ti-wallet"></i><span>Custo total</span></div><strong>R$ {{ project.finance.total_formatted }}</strong><small>{{ pf_valued ? 'Horas + avulsos' : 'Soma dos lançamentos' }}</small></div>
        </div>
      </div>
      {% endif %}
      <section class="pf-panel mt-3"><div class="pf-panel-header"><div><div class="pf-eyebrow">POR TAREFA</div><h3>Horas dedicadas em cada tarefa</h3></div><span>Execução lançada na tarefa + reuniões registradas nela. Reuniões do projeto sem tarefa entram só no total do projeto.</span></div>
        <div class="table-responsive"><table class="table pf-table pf-hours-table"><thead><tr><th>Tarefa</th><th>Estado</th><th class="text-end">Execução</th><th class="text-end">Reuniões</th><th class="text-end">Total</th>{% if pf_valued %}<th class="text-end">Valor</th>{% endif %}<th class="text-end">Previsto</th><th style="width:160px">Consumo</th></tr></thead><tbody>
          {% set sum_exec = 0 %}{% set sum_meet = 0 %}
          {% for task in tasks %}
            {% set sum_exec = sum_exec + task.hours.execution_minutes %}{% set sum_meet = sum_meet + task.hours.meeting_minutes %}
            <tr><td><a href="{{ task.task_url }}"><strong>{{ task.name }}</strong></a></td><td>{{ task.state.name }}</td><td class="text-end">{{ task.hours.execution_label }}</td><td class="text-end">{{ task.hours.meeting_label }}</td><td class="text-end"><strong>{{ task.hours.total_label }}</strong></td>{% if pf_valued %}<td class="text-end text-nowrap">R$ {{ ((task.hours.total_minutes / 60) * project.finance.rate)|number_format(2, ',', '.') }}</td>{% endif %}<td class="text-end">{{ task.hours.planned_label ?: '—' }}</td>
              <td>{% if task.hours.planned_percent is not null %}<div class="pf-hours-bar {{ task.hours.planned_percent > 100 ? 'is-over' : '' }}" title="{{ task.hours.planned_percent }}% do previsto"><span style="width:{{ min(100, task.hours.planned_percent) }}%"></span></div><small class="{{ task.hours.planned_percent > 100 ? 'pf-text-danger' : 'text-muted' }}">{{ task.hours.planned_percent }}%</small>{% else %}<small class="text-muted">Sem previsão</small>{% endif %}</td></tr>
          {% else %}
            <tr><td colspan="{{ pf_valued ? 8 : 7 }}" class="text-muted">Nenhuma tarefa ainda.</td></tr>
          {% endfor %}
        </tbody>
        {% if tasks %}<tfoot><tr><th colspan="2">Tarefas</th><th class="text-end">{{ (sum_exec // 60) ~ 'h' ~ (sum_exec % 60 ? '%02d'|format(sum_exec % 60) : '') }}</th><th class="text-end">{{ (sum_meet // 60) ~ 'h' ~ (sum_meet % 60 ? '%02d'|format(sum_meet % 60) : '') }}</th><th class="text-end">{{ ((sum_exec + sum_meet) // 60) ~ 'h' ~ ((sum_exec + sum_meet) % 60 ? '%02d'|format((sum_exec + sum_meet) % 60) : '') }}</th>{% if pf_valued %}<th class="text-end text-nowrap">R$ {{ (((sum_exec + sum_meet) / 60) * project.finance.rate)|number_format(2, ',', '.') }}</th>{% endif %}<th colspan="2" class="text-muted small">Projeto (inclui reuniões sem tarefa): {{ project.hours.total_label }}</th></tr></tfoot>{% endif %}
        </table></div>
      </section>
      <section class="pf-panel mt-3"><div class="pf-panel-header"><h3>Lançamentos recentes</h3><span>Horas de execução são lançadas dentro da tarefa.</span></div><div class="table-responsive"><table class="table pf-table"><thead><tr><th>Data</th><th>Tipo</th><th>Profissional</th><th>Duração</th>{% if pf_valued %}<th class="text-end">Valor</th>{% endif %}<th>Descrição</th></tr></thead><tbody>{% for log in project.worklogs %}<tr><td>{{ log.work_date|date('d/m/Y') }}</td><td>{{ log.work_type == 'meeting' ? 'Reunião' : 'Execução' }}</td><td>{{ log.user_name }}</td><td><strong>{{ log.duration_label }}</strong></td>{% if pf_valued %}<td class="text-end text-nowrap">R$ {{ log.value_formatted|default('0,00') }}</td>{% endif %}<td>{{ log.comment ?: '—' }}</td></tr>{% else %}<tr><td colspan="{{ pf_valued ? 6 : 5 }}" class="text-muted">Nenhuma hora registrada.</td></tr>{% endfor %}</tbody></table></div></section>
      {% if pf_fin %}<section class="pf-panel mt-3"><div class="pf-panel-header"><div><div class="pf-eyebrow">VISÃO GERENCIAL</div><h3>Custos avulsos</h3></div><strong>R$ {{ project.costs.total_formatted }}</strong></div>
        <p class="text-muted small mb-2">Visível apenas para a gestão do projeto.{% if pf_valued %} Somam ao valor das horas (R$ {{ project.finance.hours_value_formatted }}) no custo total de R$ {{ project.finance.total_formatted }}.{% endif %}</p>
        <div class="table-responsive"><table class="table pf-table"><thead><tr><th>Data</th><th>Descrição</th><th class="text-end">Valor</th><th></th></tr></thead><tbody>{% for cost in project.costs.items %}<tr><td>{{ cost.begin_date ? cost.begin_date|date('d/m/Y') : '—' }}</td><td>{{ cost.name }}{% if cost.task_id %} <a class="pf-cost-origin" href="{{ cost.task_url }}" title="Custo aprovado a partir de uma tarefa"><i class="ti ti-subtask"></i>tarefa #{{ cost.task_id }}</a>{% endif %}{% if cost.comment %}<small class="d-block text-muted">{{ cost.comment }}</small>{% endif %}</td><td class="text-end text-nowrap"><strong>R$ {{ cost.cost_formatted }}</strong></td><td class="text-end">{% if project.can_add_cost %}<button type="button" class="btn btn-sm btn-ghost-danger pf-icon-btn pf-cost-remove" data-id="{{ cost.id }}" data-project-id="{{ project.id }}" title="Remover lançamento"><i class="ti ti-trash"></i></button>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">Nenhum custo avulso lançado.</td></tr>{% endfor %}</tbody></table></div>
        {% if project.can_add_cost %}<form class="pf-inline-form pf-cost-form mt-2"><input type="hidden" name="project_id" value="{{ project.id }}"><input type="date" name="begin_date" class="form-control" value="{{ 'now'|date('Y-m-d') }}" title="Data"><input name="name" class="form-control pf-grow" placeholder="Descrição (ex.: deslocamento, licença, material)" required><input name="cost" class="form-control pf-money-input" inputmode="decimal" placeholder="Valor (R$)" required><button class="btn btn-outline-primary"><i class="ti ti-plus"></i> Lançar</button></form>{% endif %}
      </section>{% endif %}
    </section>

    {% if project.cost_approvals is not null %}
    {% set ap = project.cost_approvals %}
    <section class="pf-tab-pane" data-pf-pane="approvals">
      <div class="pf-ap" data-task-endpoint="{{ ajax_task_url }}" data-csrf="{{ csrf_token }}">
        <div class="pf-ap-head">
          <div><div class="pf-eyebrow">GESTÃO FINANCEIRA</div><h2>Aprovações de custos</h2><p>Custos lançados pela equipe nas tarefas. Só os aprovados entram no financeiro do projeto (custos avulsos{{ project.finance.valued_hours ? ' e custo total' : '' }}).</p></div>
        </div>
        <div class="pf-ap-kpis">
          <div class="pf-ap-kpi is-pending"><span><i class="ti ti-hourglass"></i></span><div><small>Aguardando</small><strong>{{ ap.pending }}</strong><em>R$ {{ ap.pending_total_formatted }}</em></div></div>
          <div class="pf-ap-kpi is-approved"><span><i class="ti ti-circle-check"></i></span><div><small>Aprovado</small><strong>R$ {{ ap.approved_total_formatted }}</strong><em>já no financeiro</em></div></div>
          <div class="pf-ap-kpi is-rejected"><span><i class="ti ti-circle-x"></i></span><div><small>Recusados</small><strong>{{ ap.rejected }}</strong><em>não contam</em></div></div>
        </div>
        <section class="pf-panel pf-ap-list">
          <div class="pf-ap-toolbar">
            <div class="pf-rp-seg" role="group" aria-label="Filtrar">
              <button type="button" class="is-active" data-pf-ap-filter="pending"><i class="ti ti-hourglass"></i>Aguardando <em>{{ ap.pending }}</em></button>
              <button type="button" data-pf-ap-filter="all"><i class="ti ti-list"></i>Todos <em>{{ ap.items|length }}</em></button>
            </div>
            <small class="text-muted">A equipe lança o custo em <strong>Responder ▾ › Adicionar custo</strong> dentro da tarefa.</small>
          </div>
          {% for c in ap.items %}
            <article class="pf-ap-item is-{{ c.status }} {{ c.status == 'pending' ? '' : 'd-none' }}" data-pf-ap-status="{{ c.status }}" data-cost-id="{{ c.id }}">
              <div class="pf-ap-main">
                <div class="pf-ap-title"><strong>{{ c.name }}</strong><span class="pf-cost-status is-{{ c.status }}"><i class="ti ti-{{ {'pending':'hourglass','approved':'circle-check','rejected':'circle-x','removed':'trash'}[c.status] }}"></i>{{ c.status_label }}</span></div>
                <div class="pf-ap-meta"><a href="{{ c.task_url }}"><i class="ti ti-subtask"></i>#{{ c.task_id }} · {{ c.task_name }}</a><span><i class="ti ti-user"></i>{{ c.user_name }}</span>{% if c.cost_date %}<span><i class="ti ti-calendar"></i>{{ c.cost_date|date('d/m/Y') }}</span>{% endif %}<span><i class="ti ti-clock"></i>lançado em {{ c.date_creation|date('d/m/Y H:i') }}</span></div>
                {% if c.comment %}<p class="pf-ap-comment">{{ c.comment }}</p>{% endif %}
                {% if c.status in ['approved','rejected'] %}<div class="pf-cost-decision"><i class="ti ti-gavel"></i>{{ c.status == 'approved' ? 'Aprovado' : 'Recusado' }} por {{ c.approver_name }}{% if c.decision_date %} em {{ c.decision_date|date('d/m/Y H:i') }}{% endif %}{% if c.decision_comment %}: {{ c.decision_comment }}{% endif %}</div>{% endif %}
                {% if c.can_decide %}
                  <div class="pf-cost-decide" data-cost-id="{{ c.id }}">
                    <input class="form-control form-control-sm" maxlength="4000" placeholder="Comentário para a equipe (opcional; recomendado ao recusar)">
                    <button type="button" class="btn btn-sm btn-success" data-pf-cost-decide="approve"><i class="ti ti-check"></i> Aprovar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-pf-cost-decide="reject"><i class="ti ti-x"></i> Recusar</button>
                  </div>
                {% endif %}
              </div>
              <div class="pf-ap-side">
                <strong class="pf-ap-value">R$ {{ c.cost_formatted }}</strong>
                {% if c.can_delete %}<button type="button" class="btn btn-sm btn-ghost-danger pf-icon-btn pf-cost-delete" data-id="{{ c.id }}" title="{{ c.status == 'approved' ? 'Remover custo (sai também do financeiro do projeto)' : 'Remover custo' }}"><i class="ti ti-trash"></i></button>{% endif %}
              </div>
            </article>
          {% endfor %}
          <div class="pf-empty-state {{ ap.pending ? 'd-none' : '' }}" data-pf-ap-empty><i class="ti ti-circle-check"></i><strong>Nada aguardando aprovação</strong><p>Quando alguém da equipe lançar um custo numa tarefa, ele aparece aqui para você aprovar ou recusar.</p></div>
        </section>
      </div>
    </section>
    {% endif %}
    <section class="pf-tab-pane" data-pf-pane="meetings">
      <div class="pf-section-heading"><div><div class="pf-eyebrow">ALINHAMENTOS</div><h2>Reuniões</h2><p>Reunião não é tarefa. Registre aqui tempo, decisões e pendências.</p></div>{% if project.can_update %}<button class="btn btn-primary pf-meeting-new" data-bs-toggle="modal" data-bs-target="#pf-meeting-modal"><i class="ti ti-plus"></i> Nova reunião</button>{% endif %}</div>
      <div class="pf-meeting-list" id="pf-meeting-list">{% for meeting in project.meetings %}<article class="pf-panel pf-meeting-card"><div class="pf-meeting-date"><strong>{{ meeting.start_at|date('d') }}</strong><span>{{ ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'][(meeting.start_at|date('n')) - 1] }}</span></div><div class="pf-meeting-body"><header><div><h3>{{ meeting.title }}</h3><span>{{ meeting.start_at|date('d/m/Y H:i') }} · {{ meeting.duration_label }} · {{ meeting.user_name }}</span></div>{% if project.can_update %}<div class="pf-meeting-actions"><button class="btn btn-sm btn-ghost-secondary pf-meeting-edit" type="button" data-bs-toggle="modal" data-bs-target="#pf-meeting-modal" data-id="{{ meeting.id }}" data-title="{{ meeting.title|e('html_attr') }}" data-start="{{ meeting.start_at|date('Y-m-d\\TH:i') }}" data-duration="{{ meeting.duration_minutes }}" data-participants="{{ meeting.participants|e('html_attr') }}" data-summary="{{ meeting.summary|e('html_attr') }}" data-decisions="{{ meeting.decisions|e('html_attr') }}" data-actions="{{ meeting.actions|e('html_attr') }}"><i class="ti ti-edit"></i></button><button class="btn btn-sm btn-ghost-danger pf-meeting-delete" type="button" data-id="{{ meeting.id }}"><i class="ti ti-trash"></i></button></div>{% endif %}</header>{% if meeting.participants %}<p><strong>Participantes:</strong> {{ meeting.participants }}</p>{% endif %}{% if meeting.summary %}<p><strong>Resumo:</strong> {{ meeting.summary }}</p>{% endif %}{% if meeting.decisions %}<p><strong>Decisões:</strong> {{ meeting.decisions }}</p>{% endif %}{% if meeting.actions %}<p><strong>Pendências:</strong> {{ meeting.actions }}</p>{% endif %}</div></article>{% else %}<div class="pf-empty-state"><i class="ti ti-calendar-off"></i><strong>Nenhuma reunião registrada</strong><p>Use esta área para separar alinhamentos da execução técnica.</p></div>{% endfor %}</div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="weekly">
      <div class="pf-rp" id="pf-rp">
        <div class="pf-rp-top">
          <div class="pf-sc-title"><div class="pf-eyebrow">CLIENTE</div><h2>Relatório de status</h2><p class="pf-rp-lead">Montado com os dados do projeto: status, entregas, andamento, riscos, reuniões, horas e próximos passos.{% if ai_enabled and project.can_update %} Com <strong>Gerar com IA</strong>, o Gemini escreve a análise executiva sobre esses mesmos números.{% endif %}</p></div>
        </div>
        <div class="pf-rp-toolbar">
          <div class="pf-rp-controls">
            <div class="pf-rp-seg" role="group" aria-label="Período do relatório">
              <button type="button" class="is-active" data-pf-rp-scope="week"><i class="ti ti-calendar-week"></i>Semana</button>
              <button type="button" data-pf-rp-scope="project"><i class="ti ti-folders"></i>Projeto inteiro</button>
            </div>
            <select class="form-select" id="pf-report-week" aria-label="Semana">{% for week in weeks %}<option value="{{ week.start }}">{{ week.current|default(false) ? 'Esta semana · ' : '' }}{{ week.label }}</option>{% endfor %}</select>
          </div>
          <div class="pf-rp-actions">
            <button class="btn btn-outline-secondary" id="pf-report-generate" title="Atualizar com os dados atuais (sem IA)"><i class="ti ti-refresh"></i> Atualizar</button>
            {% if ai_enabled and project.can_update %}<button class="btn pf-rp-ai-btn" id="pf-report-ai" title="O Gemini escreve título, resumo, riscos com ação recomendada e próximos passos sobre os números do sistema"><i class="ti ti-sparkles"></i> Gerar com IA</button>{% endif %}
            <span class="pf-rp-divider"></span>
            <button class="btn btn-ghost-secondary" id="pf-report-copy" title="Copia com formatação para colar no e-mail"><i class="ti ti-mail-forward"></i> Copiar para e-mail</button>
            <button class="btn btn-ghost-secondary" id="pf-report-print" title="Imprimir ou salvar em PDF"><i class="ti ti-printer"></i> PDF</button>
            <button class="btn btn-ghost-secondary" id="pf-report-edit" title="Editar o texto antes de enviar"><i class="ti ti-pencil"></i> <span>Editar texto</span></button>
            {% if project.can_update %}<button class="btn btn-ghost-secondary" id="pf-report-save" title="Guardar esta versão no projeto"><i class="ti ti-device-floppy"></i> Salvar versão</button>{% endif %}
          </div>
        </div>
        <div class="pf-rp-progress d-none" id="pf-rp-progress"><div class="pf-rp-progress-icon"><i class="ti ti-sparkles"></i></div><ol><li>Consolidando os dados do projeto</li><li>Analisando riscos e prioridades com IA</li><li>Montando o relatório</li></ol></div>
        <article class="pf-rp-doc" id="pf-rp-doc"><div class="pf-rp-loading"><i class="ti ti-loader-2 pf-spin"></i> Montando o relatório…</div></article>
        <textarea id="pf-weekly-report-text" class="form-control pf-rp-text d-none" data-pf-lazy="1" spellcheck="true">{{ weekly_report.text }}</textarea>
        <div class="pf-rp-meta" id="pf-report-meta"></div>
        {% if saved_reports %}
        <section class="pf-rp-saved"><h3><i class="ti ti-history"></i>Versões salvas</h3><div class="pf-saved-reports">{% for report in saved_reports %}<button type="button" data-report-content="{{ report.content|e('html_attr') }}"><strong>{{ report.week_start|date('d/m') }} - {{ report.week_end|date('d/m/Y') }}</strong><span>{{ report.date_generation|date('d/m/Y H:i') }} · {{ report.user_name }}</span><em class="pf-rp-saved-tag is-{{ report.source }}">{{ report.source == 'ai' ? 'IA' : (report.source == 'auto' ? 'Automático' : 'Texto') }}</em></button>{% endfor %}</div></section>
        {% endif %}
      </div>
    </section>

    <section class="pf-tab-pane" data-pf-pane="team">
      <div class="pf-tm-head">
        <div><div class="pf-eyebrow">PESSOAS</div><h2>Equipe do projeto</h2><p>Quem participa e com qual função. Ao atribuir alguém a uma tarefa, a pessoa entra automaticamente na equipe.</p></div>
        <div class="pf-tm-stats"><div><strong>{{ project.team|length }}</strong><span>membro(s)</span></div><div><strong>{{ team_groups|filter(g => g.id)|length }}</strong><span>função(ões)</span></div>{% if project.can_update %}<button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#pf-roles-modal"><i class="ti ti-id-badge-2"></i> Gerenciar funções</button>{% endif %}</div>
      </div>
      {% if project.can_update %}
      <form class="pf-tm-add pf-team-add-form"><input type="hidden" name="project_id" value="{{ project.id }}">
        <span class="pf-tm-add-icon"><i class="ti ti-user-plus"></i></span>
        <label>Tipo<select name="itemtype" class="form-select pf-member-type"><option value="User">Usuário</option><option value="Group">Grupo</option><option value="Supplier">Fornecedor</option><option value="Contact">Contato</option></select></label>
        <label class="pf-tm-grow">Quem<select name="items_id" class="form-select pf-member-select" required><option value="">Selecione...</option>{% for user in users %}<option data-kind="User" value="{{ user.id }}">{{ user.name }}</option>{% endfor %}{% for group in groups %}<option data-kind="Group" value="{{ group.id }}">{{ group.name }}</option>{% endfor %}{% for supplier in suppliers %}<option data-kind="Supplier" value="{{ supplier.id }}">{{ supplier.name }}</option>{% endfor %}{% for contact in contacts %}<option data-kind="Contact" value="{{ contact.id }}">{{ contact.name }}</option>{% endfor %}</select></label>
        <label>Função<select name="roles_id" class="form-select"><option value="0">Sem função</option>{% for role in team_roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}</select></label>
        <button class="btn btn-primary" type="submit"><i class="ti ti-plus"></i> Adicionar à equipe</button>
      </form>
      {% endif %}
      {% if project.team is empty %}
        <div class="pf-tm-empty"><span class="pf-tm-empty-icon"><i class="ti ti-users-plus"></i></span><strong>Equipe ainda não definida</strong><span>Adicione as pessoas do projeto e defina a função de cada uma.</span></div>
      {% else %}
        {% for r in team_groups %}
          <section class="pf-tm-group{{ r.id ? '' : ' is-norole' }}" style="--pf-role-color:{{ r.color }}"><header><i class="pf-role-dot"></i><strong>{{ r.name }}</strong><span>{{ r.count }}</span>{% if r.comment %}<small>{{ r.comment }}</small>{% endif %}</header>
            <div class="pf-tm-grid">{% for member in r.members %}
        <article class="pf-tm-card" style="--pf-role-color:{{ member.role ? member.role.color : '#94a3b8' }}">
          <span class="pf-tm-avatar">{% if member.type == 'Group' %}<i class="ti ti-users"></i>{% elseif member.type == 'Supplier' %}<i class="ti ti-building"></i>{% else %}{{ member.initials }}{% endif %}</span>
          <div class="pf-tm-info">
            <div class="pf-tm-name"><strong title="{{ member.name }}">{{ member.name }}</strong>{% if member.is_manager %}<span class="pf-tm-tag" title="Responsável pelo projeto"><i class="ti ti-star"></i> Responsável</span>{% endif %}</div>
            <div class="pf-tm-meta"><span>{{ member.type_label }}</span><span><i class="ti ti-list-check"></i> {{ member.tasks_count }} tarefa(s)</span>{% if member.type == 'User' %}<span><i class="ti ti-clock"></i> {{ member.hours_label }}</span>{% endif %}</div>
            {% if project.can_update %}<select class="form-select form-select-sm pf-role-select pf-tm-role" data-relation-id="{{ member.relation_id }}" title="Função no projeto"><option value="0">Sem função</option>{% for role in team_roles %}<option value="{{ role.id }}" {{ member.role and member.role.id == role.id ? 'selected' : '' }}>{{ role.name }}</option>{% endfor %}</select>{% elseif member.role %}<span class="pf-role-badge"><i></i>{{ member.role.name }}</span>{% endif %}
          </div>
          {% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-icon-btn pf-team-remove pf-tm-remove" data-id="{{ member.relation_id }}" title="Remover da equipe"><i class="ti ti-x"></i></button>{% endif %}
        </article>
            {% endfor %}</div>
          </section>
        {% endfor %}
      {% endif %}
    </section>

    {% if not project.is_template %}
    <section class="pf-tab-pane" data-pf-pane="workload">
      <div class="pf-wl" data-pf-workload data-lazy="1" data-endpoint="{{ ajax_workload_url }}" data-csrf="{{ csrf_token }}" data-focus-project="{{ project.id }}"></div>
    </section>
    {% endif %}
    <section class="pf-tab-pane" data-pf-pane="files">
      <div class="pf-files-grid">
        <section class="pf-panel"><div class="pf-panel-header"><div><div class="pf-eyebrow">CONTRATO</div><h2>Contrato do cliente</h2></div></div>
          {% if project.can_update %}<form class="pf-inline-form pf-contract-form"><input type="hidden" name="project_id" value="{{ project.id }}"><select name="contract_id" class="form-select"><option value="">Selecione um contrato existente...</option>{% for contract in contracts %}<option value="{{ contract.id }}">{{ contract.name }}{% if contract.number %} · {{ contract.number }}{% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary">Vincular</button></form>{% endif %}
          <div class="pf-contract-list">{% for contract in project.contracts %}<div class="pf-linked-item"><i class="ti ti-file-certificate"></i><div><a href="{{ contract.url }}"><strong>{{ contract.name }}</strong></a><span>{{ contract.number ?: 'Sem número' }}{% if contract.begin_date %} · {{ contract.begin_date|date('d/m/Y') }}{% endif %}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-contract-unlink" data-id="{{ contract.relation_id }}"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum contrato vinculado.</div>{% endfor %}</div>
        </section>
        <section class="pf-panel"><div class="pf-panel-header"><div><div class="pf-eyebrow">DOCUMENTOS</div><h2>Arquivos do projeto</h2></div><span>{{ project.documents|length }}</span></div>
          {% if project.can_add_document %}<form class="pf-document-upload" data-itemtype="Project" data-items-id="{{ project.id }}"><input type="file" name="file" class="form-control" required><button class="btn btn-outline-primary"><i class="ti ti-upload"></i> Anexar</button></form>{% endif %}
          <div class="pf-document-list">{% for doc in project.documents %}<div class="pf-linked-item"><i class="ti ti-file"></i><div><a href="{{ doc.url }}"><strong>{{ doc.name }}</strong></a><span>{{ doc.filename ?: 'Documento GLPI' }}</span><span class="pf-doc-origin">{% if doc.origins %}<i class="ti ti-subtask"></i> Tarefa: {% for origin in doc.origins %}<a href="{{ origin.url }}">#{{ origin.id }} {{ origin.name }}</a>{{ not loop.last ? ', ' : '' }}{% endfor %}{% else %}<i class="ti ti-folder"></i> Anexado no projeto{% endif %}</span></div>{% if doc.download_url %}<a class="btn btn-sm btn-ghost-secondary pf-icon-btn" href="{{ doc.download_url }}" title="Baixar"><i class="ti ti-download"></i></a>{% endif %}{% if project.can_update and doc.relation_id %}<button class="btn btn-sm btn-ghost-danger pf-document-unlink" data-itemtype="Project" data-items-id="{{ project.id }}" data-id="{{ doc.relation_id }}" title="Desvincular do projeto (continua na tarefa de origem)"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum documento anexado.</div>{% endfor %}</div>
        </section>
      </div>
    </section>
  </main>

  {% if project.can_update %}
  <div class="modal fade" id="pf-task-create-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="pf-task-create-form">
    <div class="modal-header"><div><div class="pf-eyebrow">EXECUÇÃO</div><h2 class="modal-title" id="pf-task-create-title">Nova tarefa</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><input type="hidden" name="project_id" value="{{ project.id }}"><div class="row g-3">
      <div class="col-12 pf-parent-task-wrap d-none"><label class="form-label">Tarefa pai *</label><select name="projecttasks_id" class="form-select pf-parent-task-select"><option value="0">Selecione a tarefa pai...</option>{% for t in tasks_tree %}<option value="{{ t.id }}">{% if t.depth %}{% for i in 1..t.depth %}&nbsp;&nbsp;&nbsp;{% endfor %}↳ {% endif %}#{{ t.id }} · {{ t.name }}</option>{% endfor %}</select><small class="text-muted">Somente tarefas deste projeto.</small></div>
      <div class="col-12"><label class="form-label">Título *</label><input name="name" class="form-control" required maxlength="255"></div>
      <div class="col-md-3"><label class="form-label">Estado *</label><select name="projectstates_id" class="form-select" required>{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_task_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == 3 ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Solicitado por</label><select name="requester_users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}" {{ user.id == current_user_id ? 'selected' : '' }}>{{ user.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Executor</label><select name="assignee_user_id" class="form-select"><option value="0">Definir depois</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select></div>
      <div class="col-md-4"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" class="form-control"></div><div class="col-md-4"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" class="form-control"></div><div class="col-md-4"><label class="form-label">Horas planejadas</label><input type="number" min="0" step="0.25" name="planned_duration_hours" class="form-control"></div>
      <div class="col-md-6"><label class="form-label">Tipo</label><select name="projecttasktypes_id" class="form-select"><option value="0">Não definido</option>{% for type in task_types %}<option value="{{ type.id }}">{{ type.name }}</option>{% endfor %}</select></div><div class="col-md-6 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" name="is_milestone" value="1"><span class="form-check-label">Marco do projeto</span></label></div>
      <div class="col-12 pf-task-states-picker"><label class="form-label">Estados permitidos nesta tarefa</label><input type="hidden" class="pf-task-states-value" name="allowed_states" value="{{ []|join(',') }}"><div class="pf-state-chips">{% for state in states %}<label class="pf-state-chip"><input type="checkbox" class="form-check-input pf-task-state-check" value="{{ state.id }}" {{ not [] or state.id in [] ? 'checked' : '' }}><span class="pf-column-dot" style="--pf-state-color:{{ state.color }}"></span><span>{{ state.name }}</span></label>{% endfor %}</div><small class="text-muted">A tarefa só poderá ir para os estados marcados. Todos marcados = sem restrição.</small></div>
      <div class="col-12"><label class="form-label">Descrição</label><textarea name="content" class="form-control" rows="3"></textarea></div>
      {% if project.execution_mode == 'ticket' %}<div class="col-md-4"><label class="form-label">Tipo do chamado</label><select name="ticket_type" class="form-select"><option value="2">Requisição</option><option value="1">Incidente</option></select></div><div class="col-md-8"><label class="form-label">Categoria do chamado</label><select name="itilcategories_id" class="form-select"><option value="0">Não definida</option>{% for c in ticket_categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></div>{% endif %}
      <div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" name="attention" value="1"><span class="form-check-label">Marcar como ponto de atenção</span></label></div>
      <div class="col-12"><input name="attention_note" class="form-control" placeholder="Motivo do ponto de atenção (opcional)"></div>
    </div><div class="pf-form-message"></div></div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit"><i class="ti ti-check"></i> Criar tarefa</button></div>
  </form></div></div></div>

  <div class="modal fade" id="pf-meeting-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="pf-meeting-form"><div class="modal-header"><div><div class="pf-eyebrow">ALINHAMENTO</div><h2 class="modal-title" id="pf-meeting-modal-title">Registrar reunião</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="project_id" value="{{ project.id }}"><input type="hidden" name="meeting_id" value="0"><div class="row g-3"><div class="col-md-8"><label class="form-label">Título *</label><input name="title" required class="form-control"></div><div class="col-md-4"><label class="form-label">Data e hora *</label><input type="datetime-local" name="start_at" required class="form-control"></div><div class="col-md-4"><label class="form-label">Duração (min) *</label><input type="number" min="1" max="1440" name="duration_minutes" value="60" class="form-control"></div><div class="col-md-8"><label class="form-label">Participantes</label><input name="participants" class="form-control" placeholder="Nomes, grupos ou cliente"></div><div class="col-12"><label class="form-label">Resumo</label><textarea name="summary" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Decisões</label><textarea name="decisions" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Pendências / ações</label><textarea name="actions" class="form-control" rows="3"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" id="pf-meeting-submit">Registrar reunião</button></div></form></div></div></div>

  <div class="modal fade" id="pf-roles-modal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="pf-eyebrow">EQUIPE</div><h2 class="modal-title">Funções da equipe</h2><p class="mb-0 text-muted small">Valem só para {{ project.is_template ? 'este template (e são copiadas para os projetos criados a partir dele)' : 'este projeto' }}. Excluir uma função tira ela de quem a tinha.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
    <div class="pf-role-list">{% for role in team_roles %}<div class="pf-role-item" style="--pf-role-color:{{ role.color }}"><i class="pf-role-dot"></i><div><strong>{{ role.name }}</strong>{% if role.comment %}<small>{{ role.comment }}</small>{% endif %}</div><span class="pf-role-usage" title="Membros com esta função">{{ role.usage }}</span><button type="button" class="btn btn-sm btn-ghost-secondary pf-icon-btn pf-role-edit" data-role="{{ {'id': role.id, 'name': role.name, 'color': role.color, 'comment': role.comment}|json_encode|e('html_attr') }}" title="Editar"><i class="ti ti-pencil"></i></button><button type="button" class="btn btn-sm btn-ghost-danger pf-icon-btn pf-role-delete" data-id="{{ role.id }}" data-name="{{ role.name }}" title="Excluir"><i class="ti ti-trash"></i></button></div>{% else %}<div class="pf-empty-inline">Nenhuma função cadastrada. Crie a primeira abaixo (ex.: Gerente do projeto, Analista, Ponto focal do cliente).</div>{% endfor %}</div>
    <form class="pf-role-form"><input type="hidden" name="role_id" value="0"><div class="pf-role-form-title">Nova função</div><div class="pf-role-form-grid"><input name="name" class="form-control" maxlength="120" required placeholder="Ex.: Gerente do projeto"><input type="color" name="color" class="form-control form-control-color" value="#4263eb" title="Cor"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Salvar</button></div><input name="comment" class="form-control form-control-sm mt-2" maxlength="500" placeholder="Descrição (opcional)"><div class="pf-form-message"></div></form>
  </div></div></div></div>

  <div class="modal fade" id="pf-contract-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="pf-eyebrow">CONTRATO</div><h2 class="modal-title">Contrato do projeto</h2><p class="mb-0 text-muted">Vincule o contrato da empresa/cliente a este projeto.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
    <div class="pf-contract-list mb-3">{% for contract in project.contracts %}<div class="pf-linked-item"><i class="ti ti-file-certificate"></i><div><a href="{{ contract.url }}"><strong>{{ contract.name }}</strong></a><span>{{ contract.number ?: 'Sem número' }}{% if contract.begin_date %} · {{ contract.begin_date|date('d/m/Y') }}{% endif %}</span></div>{% if project.can_update %}<button class="btn btn-sm btn-ghost-danger pf-contract-unlink" data-id="{{ contract.relation_id }}"><i class="ti ti-unlink"></i></button>{% endif %}</div>{% else %}<div class="pf-empty-inline">Nenhum contrato vinculado ao projeto.</div>{% endfor %}</div>
    {% if project.can_update %}<form class="pf-contract-form"><input type="hidden" name="project_id" value="{{ project.id }}"><label class="form-label">Vincular contrato existente</label><div class="pf-inline-form"><select name="contract_id" class="form-select" required><option value="">Selecione...</option>{% for contract in contracts %}<option value="{{ contract.id }}">{{ contract.name }}{% if contract.number %} · {{ contract.number }}{% endif %}</option>{% endfor %}</select><button class="btn btn-primary"><i class="ti ti-link"></i> Vincular</button></div></form>{% endif %}
  </div></div></div></div>

  <div class="modal fade" id="pf-project-edit-modal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><form id="pf-project-edit-form"><div class="modal-header"><div><div class="pf-eyebrow">CONFIGURAÇÕES</div><h2 class="modal-title">Projeto</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" value="{{ project.id }}"><div class="row g-3">
    <div class="col-md-8"><label class="form-label">Nome</label><input name="name" class="form-control" value="{{ project.name }}"></div><div class="col-md-4"><label class="form-label">Código</label><input name="code" class="form-control" value="{{ project.code }}"></div>
    <div class="col-md-3"><label class="form-label">Estado *</label><select name="projectstates_id" class="form-select" required>{% for state in states %}<option value="{{ state.id }}" {{ state.id == project.state.id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for p in priorities %}<option value="{{ p.id }}" {{ p.id == project.priority ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}</select></div>
    <div class="col-md-3"><label class="form-label">Responsável</label><select name="users_id" class="form-select"><option value="0">Não definido</option>{% for user in users %}<option value="{{ user.id }}" {{ user.id == project.manager_id ? 'selected' : '' }}>{{ user.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Grupo</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}" {{ group.id == project.group_id ? 'selected' : '' }}>{{ group.name }}</option>{% endfor %}</select></div>
    <div class="col-md-3"><label class="form-label">Modo de execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ project.execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ project.execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select></div><div class="col-md-3"><label class="form-label">Contabilização</label><select name="cost_mode" class="form-select pf-project-cost-mode"><option value="hours" {{ project.cost_mode == 'hours' ? 'selected' : '' }}>Horas</option><option value="money" {{ project.cost_mode == 'money' ? 'selected' : '' }}>Custo financeiro</option><option value="both" {{ project.cost_mode == 'both' ? 'selected' : '' }}>Horas + custo</option></select></div><div class="col-md-3 pf-hour-rate-wrap"><label class="form-label">Valor por hora (R$)</label><input name="hour_rate" class="form-control pf-money-input" inputmode="decimal" value="{{ project.hour_rate ? project.hour_rate|number_format(2, ',', '.') : '' }}" placeholder="Ex.: 150,00"><small class="text-muted">Cada hora lançada é valorizada por este valor.</small></div><div class="col-md-3 pf-hours-budget-wrap"><label class="form-label">Horas previstas / contratadas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" value="{{ (project.hours_budget_minutes / 60)|number_format(2, '.', '') }}"><small class="text-muted">Usado quando a contabilização é por horas.</small></div>
    <div class="col-md-3"><label class="form-label">Início</label><input type="datetime-local" name="plan_start_date" value="{{ project.plan_start_date ? project.plan_start_date|date('Y-m-d\\TH:i') : '' }}" class="form-control"></div><div class="col-md-3"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" value="{{ project.plan_end_date ? project.plan_end_date|date('Y-m-d\\TH:i') : '' }}" class="form-control"></div>
    <div class="col-md-3"><label class="form-label">Saúde</label><select name="health" class="form-select"><option value="auto" {{ project.health_configured == 'auto' ? 'selected' : '' }}>Automática</option><option value="good" {{ project.health_configured == 'good' ? 'selected' : '' }}>Saudável</option><option value="attention" {{ project.health_configured == 'attention' ? 'selected' : '' }}>Atenção</option><option value="critical" {{ project.health_configured == 'critical' ? 'selected' : '' }}>Crítico</option></select></div><div class="col-md-3"><label class="form-label">Risco</label><select name="risk_level" class="form-select"><option value="low" {{ project.risk_level == 'low' ? 'selected' : '' }}>Baixo</option><option value="normal" {{ project.risk_level == 'normal' ? 'selected' : '' }}>Normal</option><option value="high" {{ project.risk_level == 'high' ? 'selected' : '' }}>Alto</option><option value="critical" {{ project.risk_level == 'critical' ? 'selected' : '' }}>Crítico</option></select></div><div class="col-md-3"><label class="form-label">Portfólio</label><input name="portfolio" value="{{ project.portfolio }}" class="form-control"></div><div class="col-md-3"><label class="form-label">Patrocinador</label><input name="sponsor" value="{{ project.sponsor }}" class="form-control"></div>
    <div class="col-12"><label class="form-label">Objetivo</label><textarea name="objective" class="form-control" rows="2">{{ project.objective }}</textarea></div><div class="col-12"><label class="form-label">Descrição</label><textarea name="content" class="form-control" rows="3">{{ project.content }}</textarea></div>
  </div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary">Salvar</button></div></form></div></div></div>
  {% endif %}
  {% if project.contracts %}
  <div class="modal fade pf-contract-viewer" id="pf-contract-viewer" tabindex="-1" aria-hidden="true" data-contracts="{{ project.contracts|json_encode|e('html_attr') }}" data-lib-base="{{ plugin_webdir }}/lib"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header">
      <div class="pf-cv-head"><span class="pf-cv-icon"><i class="ti ti-file-certificate"></i></span><div class="min-w-0"><div class="pf-eyebrow">CONTRATO DO PROJETO</div><h2 class="modal-title" data-pf-cv-title>Contrato</h2><small class="text-muted" data-pf-cv-sub></small></div></div>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
    </div>
    <div class="pf-cv-tabs d-none" data-pf-cv-tabs></div>
    <div class="modal-body p-0"><div class="pf-cv-stage" data-pf-cv-stage></div></div>
    <div class="modal-footer pf-cv-footer">
      <a class="btn btn-ghost-secondary" data-pf-cv-glpi href="#" target="_blank" rel="noopener"><i class="ti ti-external-link"></i> Abrir contrato no GLPI</a>
      <a class="btn btn-ghost-secondary" data-pf-cv-newtab href="#" target="_blank" rel="noopener"><i class="ti ti-window-maximize"></i> Abrir em nova aba</a>
      <span class="pf-footer-spacer"></span>
      {% if project.can_update %}<button type="button" class="btn btn-outline-danger" data-pf-cv-unlink><i class="ti ti-unlink"></i> Desvincular contrato</button>{% endif %}
      <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="ti ti-x"></i> Fechar</button>
    </div>
  </div></div></div>
  {% endif %}
</div>
