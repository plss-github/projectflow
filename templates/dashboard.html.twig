<div class="pf-app {{ compact_cards ? 'pf-compact' : '' }}" id="projectflow-dashboard"
     data-project-endpoint="{{ ajax_project_url }}" data-csrf="{{ csrf_token }}" data-default-view="{{ default_view }}">
  <nav class="pf-dash-menu" aria-label="Ações do portfólio">
    <a class="pf-dash-menu-link pf-dash-menu-manager" href="{{ manager_url }}" title="Todos os projetos sob sua responsabilidade num lugar só"><i class="ti ti-layout-dashboard"></i> Central do gestor</a>
    <a class="pf-dash-menu-link" href="{{ tasks_url }}"><i class="ti ti-list-check"></i> Minhas tarefas</a>
    <a class="pf-dash-menu-link" href="{{ workload_url }}" title="Horas planejadas x capacidade de cada pessoa, por semana"><i class="ti ti-chart-bar"></i> Carga de trabalho</a>
    <a class="pf-dash-menu-link" href="{{ native_list_url }}" title="Lista de projetos nativa do GLPI (busca avançada, ações em massa)"><i class="ti ti-list-search"></i> Lista nativa</a>
    {% if archived_mode %}<a class="pf-dash-menu-link" href="{{ portfolio_url }}"><i class="ti ti-arrow-back-up"></i> Voltar ao portfólio</a>{% else %}<a class="pf-dash-menu-link" href="{{ archived_url }}" title="Projetos arquivados"><i class="ti ti-archive"></i> Arquivados</a>{% endif %}
    {% if can_create_project and not archived_mode %}
      <div class="dropdown pf-dash-menu-new">
        <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="ti ti-plus"></i> Novo projeto</button>
        <div class="dropdown-menu dropdown-menu-end pf-dash-menu-dropdown">
          <button class="dropdown-item" type="button" data-pf-new-project="0" data-bs-toggle="modal" data-bs-target="#pf-project-create-modal"><i class="ti ti-file-plus"></i> Projeto em branco</button>
          <div class="dropdown-divider"></div>
          <h6 class="dropdown-header">A partir de template</h6>
          {% if templates|length > 5 %}<div class="pf-tpl-search"><i class="ti ti-search"></i><input type="search" class="form-control form-control-sm" placeholder="Pesquisar template..." data-pf-tpl-filter autocomplete="off"></div>{% endif %}
          <div class="pf-tpl-menu-list" data-pf-tpl-list>
          {% for template in templates %}
            <button class="dropdown-item" type="button" data-pf-new-project="{{ template.id }}" data-pf-tpl-name="{{ template.name|lower }}"><i class="ti ti-template"></i> {{ template.name }}</button>
          {% else %}
            <span class="dropdown-item-text text-muted small">Nenhum template cadastrado.</span>
          {% endfor %}
          <span class="dropdown-item-text text-muted small d-none" data-pf-tpl-none>Nenhum template com esse nome.</span>
          </div>
          <div class="dropdown-divider"></div>
          <a class="dropdown-item" href="{{ templates_url }}?new=1"><i class="ti ti-square-plus"></i> Criar template</a>
          <a class="dropdown-item" href="{{ templates_url }}"><i class="ti ti-settings"></i> Gerenciar templates</a>
        </div>
      </div>
    {% endif %}
  </nav>

  {% if archived_mode %}
  <section class="pf-archived-head">
    <div><div class="pf-eyebrow">PORTFÓLIO</div><h1><i class="ti ti-archive"></i> Projetos arquivados</h1><p>Projetos arquivados ficam fora do portfólio, do Kanban, de Minhas tarefas e da Carga de trabalho, e abrem só para leitura. Use <strong>Desarquivar</strong> para trazer um de volta.</p></div>
  </section>
  {% endif %}
  <section class="pf-kpi-grid {{ archived_mode ? 'is-archived' : '' }}">
    <a class="pf-kpi {{ page.quick == 'all' ? 'is-selected' : '' }}" href="{{ page.quick_urls.all }}" data-pf-quick="all"><span class="pf-kpi-icon"><i class="ti ti-{{ archived_mode ? 'archive' : 'folders' }}"></i></span><span><small>{{ archived_mode ? 'Arquivados' : 'Visíveis' }}</small><strong>{{ stats.total }}</strong></span></a>
    <a class="pf-kpi {{ page.quick == 'active' ? 'is-selected' : '' }}" href="{{ page.quick_urls.active }}" data-pf-quick="active"><span class="pf-kpi-icon"><i class="ti ti-progress"></i></span><span><small>Ativos</small><strong>{{ stats.active }}</strong></span></a>
    <a class="pf-kpi pf-kpi-danger {{ page.quick == 'overdue' ? 'is-selected' : '' }}" href="{{ page.quick_urls.overdue }}" data-pf-quick="overdue"><span class="pf-kpi-icon"><i class="ti ti-calendar-exclamation"></i></span><span><small>Em atraso</small><strong>{{ stats.overdue }}</strong></span></a>
    <a class="pf-kpi pf-kpi-warning {{ page.quick == 'attention' ? 'is-selected' : '' }}" href="{{ page.quick_urls.attention }}" data-pf-quick="attention"><span class="pf-kpi-icon"><i class="ti ti-heart-rate-monitor"></i></span><span><small>Em atenção</small><strong>{{ stats.attention }}</strong></span></a>
    <a class="pf-kpi {{ page.quick == 'favorites' ? 'is-selected' : '' }}" href="{{ page.quick_urls.favorites }}" data-pf-quick="favorites"><span class="pf-kpi-icon"><i class="ti ti-star"></i></span><span><small>Favoritos</small><strong>{{ stats.favorites }}</strong></span></a>
    {% if not archived_mode %}<a class="pf-kpi" href="{{ tasks_url }}" data-pf-quick="tasks"><span class="pf-kpi-icon"><i class="ti ti-list-check"></i></span><span><small>Minhas tarefas</small><strong>{{ stats.my_tasks }}</strong></span></a>{% endif %}
  </section>

  <section class="card pf-search-toolbar">
    <div class="card-header search-header px-2 px-xl-3">
      <div class="search-controls d-flex justify-content-between align-items-center w-100 gap-2 flex-wrap">
        <div class="primary-controls d-flex align-items-center flex-wrap gap-1">
          <div class="btn-group">
            <button class="btn btn-sm py-1 {{ page.criteria_count ? 'btn-active-search' : 'btn-ghost-secondary' }} dropdown-toggle pf-search-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
              <i class="ti ti-list-search"></i><span>Pesquisar</span>{% if page.criteria_count %}<span class="badge bg-secondary-lt ms-1">{{ page.criteria_count }}</span>{% endif %}
            </button>
            <div class="dropdown-menu dropdown-menu-card pf-search-panel" style="width: max-content; max-width: 100vw;">
              {{ page.search_html|raw }}
            </div>
          </div>
          <div class="btn-group">
            <button class="btn btn-sm py-1 {{ page.sort.is_default ? 'btn-ghost-secondary' : 'btn-active-sort' }} dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="ti ti-arrows-sort"></i><span>Ordenado por {{ page.sort.label }}</span>
            </button>
            <div class="dropdown-menu pf-sort-menu">
              {% for opt in page.sort.options %}<a class="dropdown-item {{ opt.active ? 'active' : '' }}" href="{{ opt.url }}"><i class="ti ti-{{ opt.active ? 'check' : 'point' }}"></i>{{ opt.label }}</a>{% endfor %}
              <div class="dropdown-divider"></div>
              <a class="dropdown-item" href="{{ page.sort.toggle_url }}"><i class="ti ti-sort-{{ page.sort.order == 'ASC' ? 'descending' : 'ascending' }}"></i>{{ page.sort.order == 'ASC' ? 'Inverter: decrescente' : 'Inverter: crescente' }}</a>
            </div>
          </div>
          {% if page.quick != 'all' %}<a href="{{ page.quick_urls.all }}" class="btn btn-sm py-1 btn-active-search pf-quick-clear" title="Mostrar todos os encontrados pela pesquisa"><i class="ti ti-filter"></i>{{ {'active':'Ativos','overdue':'Em atraso','attention':'Em atenção','favorites':'Favoritos'}[page.quick] }}<i class="ti ti-x ms-1"></i></a>{% endif %}
          {% if page.criteria_count or page.quick != 'all' %}<a class="btn btn-sm btn-icon btn-ghost-secondary" href="{{ archived_mode ? archived_url : portfolio_url }}?reset=1" title="Limpar pesquisa" data-bs-toggle="tooltip"><i class="ti ti-filter-off"></i></a>{% endif %}
        </div>
        <div class="secondary-controls d-flex align-items-center gap-2">
          <span class="text-muted small d-none d-md-inline">{{ page.total }} projeto(s)</span>
          <div class="pf-view-switch" role="group" aria-label="Visualização"><button type="button" data-view="cards" title="Cards"><i class="ti ti-layout-grid"></i></button><button type="button" data-view="table" title="Tabela"><i class="ti ti-table"></i></button><button type="button" data-view="kanban" title="Kanban por estado (arraste para mudar o estado)"><i class="ti ti-layout-columns"></i></button></div>
        </div>
      </div>
    </div>
  </section>

  {% if projects is empty %}
    <div class="pf-empty"><i class="ti ti-{{ archived_mode ? 'archive-off' : 'folder-off' }}"></i><h3>{{ archived_mode ? 'Nenhum projeto arquivado' : 'Nenhum projeto encontrado' }}</h3><p>{% if page.has_criteria or page.quick != 'all' %}Nenhum projeto bate com a pesquisa. Ajuste os critérios ou limpe a pesquisa.{% elseif archived_mode %}Para arquivar, abra o projeto e use o botão Arquivar.{% else %}Não há projetos visíveis para seu perfil e entidades ativas.{% endif %}</p></div>
  {% else %}
    <section class="pf-project-grid" id="pf-project-grid">
      {% for project in projects %}
        <article class="pf-project-card" data-project-id="{{ project.id }}" data-state="{{ project.state.id }}" data-health="{{ project.health_effective }}" data-finished="{{ project.is_finished ? '1' : '0' }}" data-overdue="{{ project.is_overdue ? '1' : '0' }}" data-favorite="{{ project.is_favorite ? '1' : '0' }}" data-portfolio="{{ project.portfolio|lower }}" data-search="{{ (project.name ~ ' ' ~ project.code ~ ' ' ~ project.manager_name ~ ' ' ~ project.group_name ~ ' ' ~ project.entity_name ~ ' ' ~ project.portfolio ~ ' ' ~ project.sponsor)|lower }}">
          <div class="pf-project-card-head">
            <div class="pf-code-wrap"><span class="pf-project-code">{{ project.code ?: 'PROJ-' ~ project.id }}</span><span class="pf-health pf-health-{{ project.health_effective }}" title="Saúde do projeto"><i></i>{{ project.health_effective == 'good' ? 'Saudável' : (project.health_effective == 'attention' ? 'Atenção' : 'Crítico') }}</span></div>
            {% if archived_mode %}{% if project.can_update %}<button type="button" class="btn btn-sm btn-outline-secondary pf-unarchive" data-pf-archive="unarchive" data-project-id="{{ project.id }}" data-name="{{ project.name|e('html_attr') }}" title="Trazer de volta para o portfólio"><i class="ti ti-archive-off"></i> Desarquivar</button>{% endif %}{% else %}<button type="button" class="pf-favorite {{ project.is_favorite ? 'is-active' : '' }}" data-project-id="{{ project.id }}" aria-label="Favoritar"><i class="ti ti-star{{ project.is_favorite ? '-filled' : '' }}"></i></button>{% endif %}
          </div>
          {% if archived_mode and project.archived %}<div class="pf-archived-note"><i class="ti ti-archive"></i>Arquivado em {{ project.archived.date|date('d/m/Y H:i') }}{% if project.archived.user_name %} por {{ project.archived.user_name }}{% endif %}</div>{% endif %}
          <a class="pf-card-main-link" href="{{ project.plugin_url }}">
            <div class="pf-title-line"><h3>{{ project.name }}</h3><span class="pf-state-badge" style="--pf-state-color:{{ project.state.color }}"><i></i>{{ project.state.name }}</span>{% if project.is_paused %}<span class="pf-paused-badge" title="Projeto pausado: sem notificações"><i class="ti ti-player-pause"></i></span>{% endif %}</div>
            <p class="pf-project-desc">{{ project.objective ?: (project.content ?: 'Sem objetivo ou descrição cadastrada.') }}</p>
            <div class="pf-progress-label"><span>Progresso</span><strong>{{ project.percent_done }}%</strong></div>
            <div class="progress pf-progress"><div class="progress-bar" style="width:{{ project.percent_done }}%"></div></div>
            <div class="pf-project-signals">
              <span class="pf-priority-badge pf-priority-{{ project.priority }}"><i class="ti ti-flag"></i>{{ project.priority_name }}</span>
              <span><i class="ti ti-list-check"></i>{{ project.task_stats.completed }}/{{ project.task_stats.total }} tarefas</span>
              {% if project.task_stats.overdue %}<span class="pf-text-danger"><i class="ti ti-alert-triangle"></i>{{ project.task_stats.overdue }} atrasada(s)</span>{% endif %}{% if project.task_stats.attention %}<span class="pf-text-warning"><i class="ti ti-alert-circle"></i>{{ project.task_stats.attention }} ponto(s) de atenção</span>{% endif %}
              {% if project.portfolio %}<span><i class="ti ti-folders"></i>{{ project.portfolio }}</span>{% endif %}
            </div>
            <div class="pf-project-meta">
              <span><i class="ti ti-user"></i>{{ project.manager_name }}</span>
              <span><i class="ti ti-building"></i>{{ project.entity_name }}</span>
              <span class="{{ project.is_overdue ? 'pf-text-danger' : '' }}"><i class="ti ti-calendar-due"></i>{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : 'Sem prazo' }}</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </section>

    <section class="pf-panel pf-table-view d-none" id="pf-project-table-view">
      <div class="table-responsive"><table class="table pf-table align-middle"><thead><tr><th>Projeto</th><th>Estado</th><th>Saúde</th><th>Responsável</th><th>Portfólio</th><th>Progresso</th><th>Prazo</th><th></th></tr></thead><tbody>
      {% for project in projects %}<tr data-pf-table-project="{{ project.id }}"><td><a href="{{ project.plugin_url }}"><strong>{{ project.name }}</strong><small>{{ project.code ?: 'PROJ-' ~ project.id }}</small></a></td><td><span class="pf-state-badge" style="--pf-state-color:{{ project.state.color }}"><i></i>{{ project.state.name }}</span></td><td><span class="pf-health pf-health-{{ project.health_effective }}"><i></i>{{ project.health_effective == 'good' ? 'Saudável' : (project.health_effective == 'attention' ? 'Atenção' : 'Crítico') }}</span></td><td>{{ project.manager_name }}</td><td>{{ project.portfolio ?: '—' }}</td><td><span class="pf-table-progress"><span style="width:{{ project.percent_done }}%"></span></span>{{ project.percent_done }}%</td><td class="{{ project.is_overdue ? 'pf-text-danger' : '' }}">{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : '—' }}</td><td><a class="btn btn-sm btn-ghost-secondary" href="{{ project.plugin_url }}"><i class="ti ti-chevron-right"></i></a></td></tr>{% endfor %}
      </tbody></table></div>
    </section>

    <section class="pf-pk d-none" id="pf-project-kanban-view" aria-label="Kanban de projetos por estado">
      {% for state in states %}
        {% set col = projects|filter(p => p.state.id == state.id) %}
        <div class="pf-pk-col" data-pf-pk-state="{{ state.id }}" style="--pf-state-color:{{ state.color ?: '#94a3b8' }}">
          <header><i></i><strong>{{ state.name }}</strong><span class="pf-pk-count">{{ col|length }}</span></header>
          <div class="pf-pk-list">
            {% for project in col %}
              <a class="pf-pk-card {{ project.can_update ? 'is-draggable' : '' }}" href="{{ project.plugin_url }}" draggable="{{ project.can_update ? 'true' : 'false' }}" data-pf-table-project="{{ project.id }}" data-pf-pk-project="{{ project.id }}">
                <div class="pf-pk-top"><span class="pf-project-code">{{ project.code ?: 'PROJ-' ~ project.id }}</span><span class="pf-health pf-health-{{ project.health_effective }}"><i></i>{{ project.health_effective == 'good' ? 'Saudável' : (project.health_effective == 'attention' ? 'Atenção' : 'Crítico') }}</span></div>
                <strong class="pf-pk-name">{{ project.name }}</strong>
                <div class="pf-pk-progress"><div><i style="width:{{ project.percent_done }}%"></i></div><b>{{ project.percent_done }}%</b></div>
                <div class="pf-pk-meta">
                  <span><i class="ti ti-user"></i>{{ project.manager_name }}</span>
                  <span class="{{ project.is_overdue ? 'pf-text-danger' : '' }}"><i class="ti ti-calendar-due"></i>{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : 'Sem prazo' }}</span>
                  <span><i class="ti ti-list-check"></i>{{ project.task_stats.completed }}/{{ project.task_stats.total }}</span>
                </div>
              </a>
            {% endfor %}
            <div class="pf-pk-empty">Nenhum projeto</div>
          </div>
        </div>
      {% endfor %}
    </section>
    {% if page.total %}<div class="card pf-search-footer"><div class="card-footer search-footer">{{ page.pager_html|raw }}</div></div>{% endif %}
  {% endif %}

  {% if can_create_project %}
  <div class="modal fade" id="pf-project-create-modal" data-bs-focus="false" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content pf-modal-content">
    <form id="pf-project-create-form">
      <div class="modal-header"><div><div class="pf-eyebrow">NOVO PROJETO</div><h2 class="modal-title fs-4">Criar projeto</h2><p class="mb-0 text-muted">Crie do zero ou clone um template nativo do GLPI.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><input type="hidden" name="action" value="create"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <nav class="pf-form-tabs" role="tablist"><button type="button" data-pf-form-tab="ident" class="is-active"><span class="pf-form-tab-step">1</span><i class="ti ti-id"></i><span>Identificação</span></button><button type="button" data-pf-form-tab="plan"><span class="pf-form-tab-step">2</span><i class="ti ti-calendar-stats"></i><span>Planejamento</span></button><button type="button" data-pf-form-tab="gov"><span class="pf-form-tab-step">3</span><i class="ti ti-shield-check"></i><span>Governança</span></button><button type="button" data-pf-form-tab="cost"><span class="pf-form-tab-step">4</span><i class="ti ti-coin"></i><span>Contabilização</span></button><button type="button" data-pf-form-tab="tasks"><span class="pf-form-tab-step">5</span><i class="ti ti-list-check"></i><span>Tarefas</span><em class="pf-form-tab-badge d-none" id="pf-tpl-task-badge"></em></button></nav>
        <div class="pf-template-applied d-none" id="pf-template-applied"><i class="ti ti-template"></i><div><strong>Preenchido com o template <span data-pf-tpl-name></span></strong><small>Todas as abas receberam as definições do template. Ajuste o que precisar e escolha as tarefas na aba <a href="#" data-pf-goto-form-tab="tasks">Tarefas</a>.</small></div></div>
        <div class="pf-form-section" data-pf-form-pane="ident"><p class="pf-pane-lead">Nome, template de origem e contexto do projeto.</p><div class="row g-3">
          <div class="col-lg-8"><label class="form-label">Nome *</label><input name="name" class="form-control" maxlength="255" required placeholder="Ex.: Implantação GLPI - Cliente XYZ"></div>
          <div class="col-lg-4"><label class="form-label">Código</label><input name="code" class="form-control" maxlength="255" placeholder="PRJ-001"></div>
          <div class="col-lg-4"><label class="form-label">Template</label><select name="template_id" class="form-select" data-pf-searchable="Pesquisar template pelo nome"><option value="0">Projeto em branco</option>{% for template in templates %}<option value="{{ template.id }}">{{ template.name }}</option>{% endfor %}</select></div>
          <div class="col-lg-4"><label class="form-label">Entidade</label><select name="entities_id" class="form-select">{% for entity in entities %}<option value="{{ entity.id }}">{{ entity.name }}</option>{% endfor %}</select></div>
          <div class="col-lg-4"><label class="form-label">Tipo</label><select name="projecttypes_id" class="form-select"><option value="0">Não definido</option>{% for type in project_types %}<option value="{{ type.id }}">{{ type.name }}</option>{% endfor %}</select></div>
          <div class="col-12"><label class="form-label">Objetivo / descrição executiva</label><textarea name="objective" class="form-control" rows="2" maxlength="4000" placeholder="O que este projeto pretende entregar e qual resultado é esperado?"></textarea></div>
          <div class="col-12"><label class="form-label">Descrição operacional</label><textarea name="content" class="form-control" rows="3" maxlength="10000"></textarea></div>
        </div></div>
        <div class="pf-form-section d-none" data-pf-form-pane="plan"><p class="pf-pane-lead">Estado inicial, responsáveis e datas planejadas.</p><div class="row g-3">
          <div class="col-md-3"><label class="form-label">Estado</label><select name="projectstates_id" class="form-select">{% for state in states %}<option value="{{ state.id }}" {{ state.id == default_project_state_id ? 'selected' : '' }}>{{ state.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Prioridade</label><select name="priority" class="form-select">{% for priority in priorities %}<option value="{{ priority.id }}" {{ priority.id == 3 ? 'selected' : '' }}>{{ priority.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Execução</label><select name="execution_mode" class="form-select"><option value="direct" {{ default_execution_mode == 'direct' ? 'selected' : '' }}>Tarefa direta</option><option value="ticket" {{ default_execution_mode == 'ticket' ? 'selected' : '' }}>Tarefa + chamado</option></select></div>
          <div class="col-md-3"><label class="form-label">Responsável</label>{{ manager_dropdown|raw }}</div>
          <div class="col-md-3"><label class="form-label">Grupo responsável</label><select name="groups_id" class="form-select"><option value="0">Não definido</option>{% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></div>
          <div class="col-md-3"><label class="form-label">Início planejado</label><input type="datetime-local" name="plan_start_date" class="form-control"></div>
          <div class="col-md-3"><label class="form-label">Prazo</label><input type="datetime-local" name="plan_end_date" class="form-control"></div>
        </div></div>
        <div class="pf-form-section d-none" data-pf-form-pane="gov"><p class="pf-pane-lead">Portfólio, patrocinador, saúde, risco e visibilidade.</p><div class="row g-3">
          <div class="col-md-3"><label class="form-label">Portfólio</label><input name="portfolio" class="form-control" maxlength="190" placeholder="Ex.: Segurança"></div>
          <div class="col-md-3"><label class="form-label">Patrocinador</label><input name="sponsor" class="form-control" maxlength="190"></div>
          <div class="col-md-3"><label class="form-label">Saúde</label><select name="health" class="form-select"><option value="auto">Automática</option><option value="good">Saudável</option><option value="attention">Atenção</option><option value="critical">Crítico</option></select></div>
          <div class="col-md-3"><label class="form-label">Risco</label><select name="risk_level" class="form-select"><option value="low">Baixo</option><option value="normal" selected>Normal</option><option value="high">Alto</option><option value="critical">Crítico</option></select></div>
          <div class="col-md-3 d-flex align-items-end"><label class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="auto_percent_done" value="1" checked><span class="form-check-label">Progresso automático</span></label></div>
          <div class="col-md-3 d-flex align-items-end"><label class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="is_recursive" value="1"><span class="form-check-label">Visível em subentidades</span></label></div>
        </div></div>
        <div class="pf-form-section pf-accounting-section d-none" data-pf-form-pane="cost"><p class="pf-pane-lead">Defina como o esforço e o custo deste projeto serão acompanhados.</p>
          <div class="pf-accounting-options">
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="hours" {{ default_cost_mode == 'hours' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-clock-hour-4"></i></span><span><strong>Contabilizar horas</strong><small>Controle por horas de execução e reuniões, com previsto, consumido e saldo.</small></span></label>
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="money" {{ default_cost_mode == 'money' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-currency-real"></i></span><span><strong>Custo financeiro</strong><small>Habilita lançamentos monetários do projeto para usuários com acesso gerencial.</small></span></label>
            <label class="pf-accounting-card"><input type="radio" name="cost_mode" value="both" {{ default_cost_mode == 'both' ? 'checked' : '' }}><span class="pf-accounting-icon"><i class="ti ti-coin"></i></span><span><strong>Horas + custo</strong><small>Horas previstas com valor por hora: cada hora lançada vira custo, e a gestão lança valores avulsos.</small></span></label>
          </div>
          <div class="row g-3 mt-1 pf-hours-budget-wrap"><div class="col-md-4"><label class="form-label">Horas previstas / contratadas</label><input type="number" min="0" step="0.25" name="hours_budget_hours" class="form-control" placeholder="Ex.: 160"><small class="text-muted">Usado para calcular consumo e saldo quando o projeto é contabilizado por horas.</small></div><div class="col-md-4 pf-hour-rate-wrap"><label class="form-label">Valor por hora (R$)</label><input name="hour_rate" class="form-control pf-money-input" inputmode="decimal" placeholder="Ex.: 150,00"></div></div>
        </div>
        <div class="pf-form-section d-none" data-pf-form-pane="tasks"><p class="pf-pane-lead">Tarefas que vêm do template. Desmarque as que não devem ser criadas neste projeto.</p>
          <input type="hidden" name="template_task_ids" value=""><input type="hidden" name="template_tasks_filtered" value="">
          <div class="pf-tpl-tasks-empty" id="pf-tpl-tasks-empty"><i class="ti ti-list-details"></i><strong>Projeto em branco</strong><span>Escolha um template na aba Identificação para trazer as tarefas dele. Sem template, você cria as tarefas depois, dentro do projeto.</span></div>
          <div class="pf-tpl-tasks d-none" id="pf-tpl-tasks">
            <div class="pf-tpl-tasks-toolbar"><span id="pf-tpl-tasks-count"></span><div class="btn-group btn-group-sm"><button type="button" class="btn btn-outline-secondary" data-pf-tpl-check="all"><i class="ti ti-checks"></i> Marcar todas</button><button type="button" class="btn btn-outline-secondary" data-pf-tpl-check="none"><i class="ti ti-square"></i> Desmarcar todas</button></div></div>
            <div class="pf-tpl-task-list" id="pf-tpl-task-list"></div>
          </div>
        </div>
        <div class="pf-form-message" id="pf-project-create-message"></div>
      </div>
      <div class="modal-footer pf-form-tabs-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><span class="pf-footer-spacer"></span><button type="button" class="btn btn-outline-secondary pf-form-prev d-none"><i class="ti ti-arrow-left"></i> Voltar</button><button type="button" class="btn btn-outline-primary pf-form-next">Próximo <i class="ti ti-arrow-right"></i></button><button type="submit" class="btn btn-primary"><i class="ti ti-check"></i> Criar projeto</button></div>
    </form>
  </div></div></div>
  {% endif %}
</div>
